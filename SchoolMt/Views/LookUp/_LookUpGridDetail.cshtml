@model List<MDL.LookUpDetailMDL>
@{
    var objPagingmdl = (MDL.Common.BasicPagingMDL)ViewBag.paging;
    int SerialNo = (objPagingmdl.CurrentPage - 1) * objPagingmdl.RowParPage + 1;

}
<div class="col-md-12">
    <div class="table-responsive">
        <table cellspacing="0" cellpadding="0" border="0" class="table table-bordered table-hover" id="">
            <thead>
                <tr>
                    <th class="text-center">S.No</th>
                    <th class="text-center">School Name</th>
                    <th class="text-center">Look Up</th>
                    <th class="text-center">Look Up Detail Name</th>
                    <th class="text-center">Min Value</th>
                    <th class="text-center">Max Value</th>
                    <th class="text-center">Status</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="31">
                            <div class="text-danger">No Record Found </div>
                        </td>
                    </tr>

                }
                else
                {

                    foreach (var item in Model)
                    {
            <tr>
                <td align="center">@SerialNo</td>
                <td class="text-center">
                    @Html.DisplayFor(modelItem => item.CompanyName)
                </td>

                <td class="text-center">
                    @Html.DisplayFor(modelItem => item.LookupName)
                </td>

                <td class="text-center">
                    @Html.DisplayFor(modelItem => item.LookupDetailName)
                </td>
                <td class="text-center">
                    @Html.DisplayFor(modelItem => item.MinValue)
                </td>
                <td class="text-center">
                    @Html.DisplayFor(modelItem => item.MaxValue)
                </td>
                <td class="text-center">
                    @Html.DisplayFor(modelItem => item.Status)
                </td>


                <td class="text-center">
                    @*@if (ViewBag.CanEdit)
            {*@
                    <a class="btn btn-primary" href="@Url.Action("AddEditLookupDetail", new { id = item.PkId })">Edit</a><br />
                    @*}*@
                </td>

            </tr>
                        SerialNo++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>
@Html.Partial("_Paging", (MDL.Common.BasicPagingMDL)ViewBag.paging)


