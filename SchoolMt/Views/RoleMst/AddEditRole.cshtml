@model MDL.RoleMstMDL
@{
    ViewBag.Title = "AddEditRole";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Put styles in the layout HEAD, not in body ideally -->
<style>
    .bold {
        font-weight: bold;
    }
</style>

@using (Html.BeginForm("AddEditRole", "RoleMst", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.HiddenFor(E => E.PK_RoleId)

    <div class="page-heading mb-0">
        <div class="page-title">
            <div class="row">
                <div class="col-12 col-md-6 order-md-1 order-last">
                    <h3>Add/Edit Role</h3>
                </div>
                <div class="col-12 col-md-6 order-md-2 order-first text-end">
                    <nav aria-label="breadcrumb" class="breadcrumb-header">
                        <ol class="breadcrumb justify-content-end mb-0">
                            <li class="breadcrumb-item"><a href="">Dashboard</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Add Edit Role</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-content">
            <div class="card-body">
                <div class="row">
                    <div class="col-lg-8 offset-lg-1">
                        <div class="form-body">
                            <div class="row">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                <!-- Company Name -->
                                <div class="col-md-3">
                                    <label class="setForm bold">Company Name<span style="color:red">*</span></label>
                                </div>
                                <div class="col-md-7 form-group">
                                    @Html.DropDownListFor(E => E.FK_CompanyId,
                                        new SelectList((System.Collections.IEnumerable)ViewData["CompanyList"], "ID", "Value"),
                                        "--Select--",
                                        new { @class = "form-control select2" })
                                    @Html.ValidationMessageFor(E => E.FK_CompanyId, "", new { @class = "text-danger" })
                                </div>

                                <!-- Role Name -->
                                <div class="col-md-3">
                                    <label class="setForm bold">Role Name<span style="color:red">*</span></label>
                                </div>
                                <div class="col-md-7 form-group">
                                    @Html.TextBoxFor(E => E.RoleName, new { @class = "form-control", @maxlength = "100", @placeholder = "Role Name" })
                                    @Html.ValidationMessageFor(E => E.RoleName, "", new { @class = "text-danger" })
                                </div>

                                <!-- Home Page -->
                                <div class="col-md-3">
                                    <label class="setForm bold">Home Page</label>
                                </div>
                                <div class="col-md-7 form-group">
                                    @Html.DropDownListFor(E => E.FK_FormId,
                                        new SelectList((System.Collections.IEnumerable)ViewData["FormList"], "ID", "Value"),
                                        "--Select--",
                                        new { @class = "form-control select2" })
                                    @Html.ValidationMessageFor(E => E.FK_FormId, "", new { @class = "text-danger" })
                                </div>

                                <!-- Status -->
                                <div class="col-md-3">
                                    <label class="setForm bold">Status<span style="color:red">*</span></label>
                                </div>
                                <div class="col-md-7 form-group">
                                    @Html.DropDownListFor(E => E.Status, new List<SelectListItem>()
                                                                                          {
                                                                                            new SelectListItem() { Value = "Active", Text ="Active",Selected=true },
                                                                                            new SelectListItem() { Value="InActive", Text="InActive"},

                                                                                          }, new { @class = "form-control select2" })
                                </div>

                                <!-- Submit/Reset Buttons -->
                                <div class="col-sm-9 d-flex justify-content-end">
                                    <button type="submit" class="btn btn-primary me-1 mb-1">Submit</button>
                                    <button type="reset" class="btn btn-light-secondary me-1 mb-1">Reset</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <link href="~/app-assets/vendors/css/forms/selects/select2.min.css" rel="stylesheet" />
    <script src="~/app-assets/vendors/js/forms/select/select2.full.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('.select2').select2();
        });
    </script>
}
