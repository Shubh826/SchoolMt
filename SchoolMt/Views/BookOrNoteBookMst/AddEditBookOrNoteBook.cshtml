@model MDL.BookOrNoteBookMst

@{
    ViewBag.Title = "AddEditBookOrNoteBook";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("AddEditBookOrNoteBook", "BookOrNoteBookMst"))
{
    @Html.HiddenFor(E => E.PK_BookId)

    <!-- Page Heading -->
    <div class="page-heading mb-3">
        <div class="page-title">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h3>Add/Edit Book or Notebook</h3>
                </div>
                <div class="col-md-6 text-md-end text-start">
                    <nav aria-label="breadcrumb" class="breadcrumb-header">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="#">Dashboard</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Add/Edit Book or Notebook</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Form Card -->
    <div class="card">
        <div class="card-body">
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Type<span class="text-danger">*</span></label>
                        </div>
                        <div class="col-md-7">
                            @Html.DropDownListFor(E => E.Type, new List<SelectListItem> {
                                new SelectListItem { Value = "Book", Text = "Book" },
                                new SelectListItem { Value = "Notebook", Text = "Notebook" }
                            }, "--Select Type--", new { @class = "form-control", id = "Type" })
                            @Html.ValidationMessageFor(E => E.Type, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <!-- Book Fields -->
                    <div id="bookFields">
                        <div class="row mb-3">
                            <div class="col-md-3">
                                <label class="form-label fw-bold">Class Name<span class="text-danger">*</span></label>
                            </div>
                            <div class="col-md-7">
                                @Html.DropDownListFor(E => E.ClassName, new SelectList((IEnumerable<object>)ViewData["ClassList"], "Value", "Value"), "--Select--", new { @class = "form-control", id = "ClassName" })
                                @Html.ValidationMessageFor(E => E.ClassName, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-3">
                                <label class="form-label fw-bold">Book Name<span class="text-danger">*</span></label>
                            </div>
                            <div class="col-md-7">
                                @Html.TextBoxFor(E => E.BookName, new { @class = "form-control", maxlength = "200", placeholder = "Enter Book Name", id = "BookName" })
                                @Html.ValidationMessageFor(E => E.BookName, "", new { @class = "text-danger small" })
                            </div>
                        </div>
                    </div>

                    <!-- Notebook Fields -->
                    <div id="notebookFields">
                        <div class="row mb-3">
                            <div class="col-md-3">
                                <label class="form-label fw-bold">Notebook Page Count<span class="text-danger">*</span></label>
                            </div>
                            <div class="col-md-7">
                                @Html.TextBoxFor(E => E.NoteBookPageCount, new { @class = "form-control", maxlength = "5", placeholder = "Enter Page Count", id = "NoteBookPageCount" })
                                @Html.ValidationMessageFor(E => E.NoteBookPageCount, "", new { @class = "text-danger small" })
                            </div>
                        </div>
                    </div>

                    <!-- Common Fields -->
                    <div id="allFields">
                        <div class="row mb-3">
                            <div class="col-md-3">
                                <label class="form-label fw-bold">Price<span class="text-danger">*</span></label>
                            </div>
                            <div class="col-md-7">
                                @Html.TextBoxFor(E => E.Price, new { @class = "form-control", maxlength = "10", placeholder = "Enter Price" })
                                @Html.ValidationMessageFor(E => E.Price, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-3">
                                <label class="form-label fw-bold">Status<span class="text-danger">*</span></label>
                            </div>
                            <div class="col-md-7">
                                @Html.DropDownListFor(E => E.Status, new List<SelectListItem> {
                                    new SelectListItem { Value = "Active", Text = "Active" },
                                    new SelectListItem { Value = "Inactive", Text = "Inactive" }
                                }, new { @class = "form-control" })
                                @Html.ValidationMessageFor(E => E.Status, "", new { @class = "text-danger small" })
                            </div>
                        </div>
                    </div>

                    <!-- Submit/Reset Buttons -->
                    <div class="row mt-4">
                        <div class="col-md-12 text-center">
                            <button type="submit" class="btn btn-primary me-2 mb-1">Submit</button>
                            <button type="reset" class="btn btn-light-secondary me-1 mb-1">Reset</button>
                      </div>
                    </div>


                </div>
            </div>
        </div>
    </div>
}


@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @*<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>*@

    <script>
        $(document).ready(function () {
            function toggleFields() {
                var selectedType = $("#Type").val();

                if (selectedType === "Book") {
                    $("#bookFields").show();
                    $("#notebookFields").hide();

                    // Enable Book Name & Class Name validation
                    $("#BookName").prop("required", true);
                    $("#ClassName").prop("required", true);
                    $("#NoteBookPageCount").prop("required", false).val("");
                }
                else if (selectedType === "Notebook") {
                    $("#bookFields").hide();
                    $("#notebookFields").show();

                    // Enable Notebook Page Count validation
                    $("#BookName").prop("required", false).val("");
                    $("#ClassName").prop("required", false).val("");
                    $("#NoteBookPageCount").prop("required", true);
                }
                else {
                    $("#bookFields, #notebookFields").hide();
                }
            }

            // Run on page load
            toggleFields();

            // Run on Type change
            $("#Type").change(function () {
                toggleFields();
            });
        });
    </script>
    }   
