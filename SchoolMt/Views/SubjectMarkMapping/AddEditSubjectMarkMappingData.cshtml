@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <link href="~/app-assets/vendors/css/forms/selects/select2.min.css" rel="stylesheet" />
    <script src="~/app-assets/vendors/js/forms/select/select2.full.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function (e) {



            if ($('#PKId').val() > 0) {
               // GetExamType($('#FK_CompanyId').val(), 'Exam Type')
                BindSubjectWiseMarksList($('#FK_CompanyId').val(), $('#hdnExamCategoryId').val(), $('#PKId').val());
                BindStudent($('#FK_CompanyId').val(), $("#FK_ClassId").val());
                $("#CategoryListSection").show();
                var selectedText = $("#FK_ExamCategoryId option:selected").text().toLowerCase();

                // debugger;
                if (selectedText.includes("term 2")) {
                    $("#AttendanceSection").show();
                    $("#remarksSection").show();
                    $("#promotedtoclassSection").show();
                } else {
                    $("#AttendanceSection").hide();
                    $("#remarksSection").hide();
                    $("#promotedtoclassSection").hide();
                }
            }


            // Company change
            $("#FK_CompanyId").change(function (e) {

                BindStudent($("#FK_CompanyId").val(), $('#FK_ClassId').val());
                //GetExamType($("#FK_CompanyId").val(), 'Exam Type');
                $("#FK_ClassId").val("").trigger('change');
                $("#tblExamTypes tbody").empty();
                $("#selectAllExamTypes").prop('checked', false);
                $("#CategoryListSection").hide();
            });

            // Company change
            $("#FK_ClassId").change(function () {

                BindStudent($("#FK_CompanyId").val(), $('#FK_ClassId').val());
                //GetExamType($("#FK_CompanyId").val(), 'Exam Type');
                $("#tblExamTypes tbody").empty();
                $("#selectAllExamTypes").prop('checked', false);
                $("#CategoryListSection").hide();

            });


            // Exam Type change
            $("#FK_ExamCategoryId").change(function (e) {
                var selectedText = $("#FK_ExamCategoryId option:selected").text().toLowerCase();

               // debugger;
                if (selectedText.includes("term 2")) {
                    $("#AttendanceSection").show();
                    $("#remarksSection").show();
                    $("#promotedtoclassSection").show();
                } else {
                    $("#AttendanceSection").hide();
                    $("#remarksSection").hide();
                    $("#promotedtoclassSection").hide();
                }
                BindSubjectWiseMarksList($('#FK_CompanyId').val(), $('#FK_ExamCategoryId').val(),0);
                $("#CategoryListSection").show();
            });

            //$('#FK_CompanyId').select2();
            //$('#LookUpDetailId').select2();
            //$('#FK_ClassId').select2();
            //$('#FK_StudentId').select2();

            // Select/Deselect all exam type checkboxes
            $(document).on('change', '#selectAllExamTypes', function () {
                var checked = $(this).is(':checked');
                $('.examTypeCheckbox').prop('checked', checked);
            });

            $(document).on('change', '.examTypeCheckbox', function () {
                var allChecked = $('.examTypeCheckbox').length === $('.examTypeCheckbox:checked').length;
                $('#selectAllExamTypes').prop('checked', allChecked);
            });

            // Initialize Select2
            $('#FK_CompanyId').select2();
            $('#LookUpDetailId').select2();
            $('#FK_ClassId').select2();
            $('#FK_StudentId').select2();
            $('#FK_ExamCategoryId').select2();

         // Submit button validation
$('#btnsubmit').click(function (e) {
    e.preventDefault();

    /* ---------------- BASIC VALIDATION ---------------- */
    if (!$("#FK_CompanyId").val()) {
        alert("Please select School");
        return;
    }

    if (!$("#FK_ClassId").val()) {
        alert("Please select Class");
        return;
    }

    if (!$("#FK_StudentId").val()) {
        alert("Please select Student");
        return;
    }

    if (!$("#FK_ExamCategoryId").val()) {
        alert("Please select Exam Category");
        return;
    }

    var selectedText = $("#FK_ExamCategoryId option:selected").text().toLowerCase();

    if (selectedText.includes("term 2")) {

        if (!$("#Attendancecount").val()) {
            alert("Please enter Attendance");
            return;
        }

        if (!$("#Remarks").val()) {
            alert("Please enter Remarks");
            return;
        }

        if (!$("#PromotedToClass").val()) {
            alert("Please enter Promoted To Class");
            return;
        }
    }




    /* ---------------- BUILD MARKS JSON ---------------- */
    var marks = [];
    var isValid = true;

    $("#tblExamTypes tbody tr").each(function () {

        var subjectId = $(this).data("subjectid");


        $(this).find(".obtain-marks").each(function () {

            var obtain = parseInt($(this).val()) || 0;
            var total = parseInt($(this).data("total"));
            var examTypeId = $(this).data("examtypeid");

            /* -------- MARKS VALIDATION -------- */
            if (obtain > total) {
                alert("Obtain marks cannot be greater than " + total);
                isValid = false;
                return false;
            }

            if (obtain < 0) {
                alert("Marks cannot be negative");
                isValid = false;
                return false;
            }

            marks.push({
                SubjectId: subjectId,
                ExamTypeId: examTypeId,
                TotalMark: total,
                ObtainMark: obtain
            });
        });

        if (!isValid) return false;
    });

    if (!isValid) return;

    if (marks.length === 0) {
        alert("No marks entered");
        return;
    }

    /* ---------------- CO-SCHOLASTIC JSON + VALIDATION ---------------- */
    var coScholasticGrades = [];

    $("#tblCoScholastic tbody tr").each(function () {

        var grade = $(this).find(".co-grade").val();
        var coId = $(this).data("coscholasticid");

        if (!grade) {
            alert("Please select grade for all Co-Scholastic Areas");
            isValid = false;
            return false;
        }

        coScholasticGrades.push({
            Id: coId,
            Value: grade
        });
    });

    if (!isValid) return;

    /* ---------------- FINAL PAYLOAD ---------------- */
    var payload = {
        CompanyId: $("#FK_CompanyId").val(),
        ClassId: $("#FK_ClassId").val(),
        StudentId: $("#FK_StudentId").val(),
        ExamCategoryId: $("#FK_ExamCategoryId").val(),
        PKId: $("#PKId").val(),
        Attendancecount: $("#Attendancecount").val(),
        Remarks: $("#Remarks").val(),
        PromotedToClass: $("#PromotedToClass").val(),
        Marks: marks,
        CoScholasticGrades: coScholasticGrades
    };

    /* ---------------- AJAX INSERT ---------------- */
    $.ajax({
        url: "@Url.Action("InsertSubjectWiseMarks", "SubjectMarkMapping")",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify(payload),
        beforeSend: function () {
            $(".modalBgLoader, .modalLoaderCenter").show();
        },
        success: function (res) {
            if (res.Success) {
                alert("Marks saved successfully");
                window.location.href = "@Url.Action("Index")";
            } else {
                alert(res.Message);
            }
        },
        complete: function () {
            $(".modalBgLoader, .modalLoaderCenter").hide();
        },
        error: function () {
            alert("Something went wrong");
        }
    });
});




        });

        function GetExamType(companyid, lookUpTypeName) {
            //debugger;
            $("#LookUpDetailId").html("");
            $("#LookUpDetailId").append(
                $('<option></option>').val("0").html("--SELECT--")
            );
          //  alert($('#hdnLookUpId').val());

            if (!companyid || companyid === "0") return;

            $.ajax({
                url: "@Url.Action("GetLookUpDetailList", "SubjectMarkMapping")",
                type: "GET",
                dataType: "JSON",
                data: { companyid: companyid, lookUpTypeName: lookUpTypeName },
                success: function (data) {
                    if (data && data.length > 0) {
                        $.each(data, function (i, item) {
                            $("#LookUpDetailId").append($('<option></option>').val(item.ID).html(item.Value));
                        });
                    }

                    // Set selected for edit

                    if ($('#hdnLookUpId').val() && $('#hdnLookUpId').val() !== '0') {
                        $('#LookUpDetailId').val($('#hdnLookUpId').val()).attr("selected", "selected");
                    }
                }
            });
        }

   function BindSubjectWiseMarksList(companyid, examtypeId, PkId) {

    var $thead = $("#tblExamTypes thead");
    var $tbody = $("#tblExamTypes tbody");
    var $coBody = $("#tblCoScholastic tbody");

    $thead.empty();
    $tbody.empty();
    $coBody.empty();

    $.ajax({
        url: "@Url.Action("GetSubjectWiseMarksWithHeaderList", "SubjectMarkMapping")",
        type: "POST",
        data: { companyid: companyid, examtypeId: examtypeId, PkId: PkId },
        success: function (res) {

            if (!res) return;

            /* ================= HEADER ================= */
            if (res.HeaderList && res.HeaderList.length > 0) {

                var headerRow = `<tr><th>Subject</th>`;

                $.each(res.HeaderList, function (i, h) {
                    headerRow += `
                        <th data-examtypeid="${h.ID}" data-max="${h.TotalMark}">
                            ${h.ExamType} (${h.TotalMark})
                        </th>`;
                });

                headerRow += "</tr>";
                $thead.append(headerRow);
            }

            /* ================= SUBJECT ROWS ================= */
            if (res.DetailList && res.DetailList.length > 0) {

                var subjects = {};

                $.each(res.DetailList, function (i, item) {
                    if (!subjects[item.Value]) {
                        subjects[item.Value] = { SubjectId: item.ID, Marks: [] };
                    }
                    subjects[item.Value].Marks.push(item);
                });

                $.each(subjects, function (subjectName, subjectObj) {

                    var row = `<tr data-subjectid="${subjectObj.SubjectId}">
                                <td>${subjectName}</td>`;

                    $.each(res.HeaderList, function (hIndex, header) {
                       // debugger;
                        var match = subjectObj.Marks.find(m => m.ExamType === header.ExamType);

                        var obtainDefault = 0;

                        if (match && match.ObtainMark != null) {
                            obtainDefault = match.ObtainMark;
                        }
                        else {
                            // Default value logic
                            if (header.ExamType === "SE" || header.ExamType === "Nbs") {
                                obtainDefault = header.TotalMark; // 5
                            }
                        }

                        var obtain = match ? match.ObtainMark : obtainDefault;

                        row += `
                            <td>
                                <input type="number"
                                       class="form-control obtain-marks text-center"
                                       value="${obtain}"
                                       min="0"
                                       max="${header.TotalMark}"
                                       data-examtypeid="${header.ID}"
                                       data-total="${header.TotalMark}" />
                            </td>`;
                    });

                    row += "</tr>";
                    $tbody.append(row);
                });
            }
            /* ================= CO-SCHOLASTIC ================= */
            if (res.CoScholasticList && res.CoScholasticList.length > 0) {

                $.each(res.CoScholasticList, function (i, item) {

                    var row = `
            <tr data-coscholasticid="${item.ID}">
                <td>${item.ExamType}</td>
                <td>
                    <select class="form-control co-grade">
                        <option value="A" ${item.ObtainMark === 'A' ? 'selected' : ''}>A</option>
                        <option value="B" ${item.ObtainMark === 'B' ? 'selected' : ''}>B</option>
                        <option value="C" ${item.ObtainMark === 'C' ? 'selected' : ''}>C</option>
                        <option value="D" ${item.ObtainMark === 'D' ? 'selected' : ''}>D</option>
                        <option value="E" ${item.ObtainMark === 'E' ? 'selected' : ''}>E</option>
                    </select>
                </td>
            </tr>`;

                    $coBody.append(row);
                });
            }

        }
    });
}



     function BindStudent(companyId, classId) {
    $("#FK_StudentId").html("");
    $("#FK_StudentId").append(
        $('<option></option>').val("0").html("--SELECT--")
    );

    if (!classId || classId == "0" || !companyId || companyId == "0") {
        return;
    }

    $.ajax({
        url: "@Url.Action("BindStudent", "SubjectMarkMapping")",
        type: "POST",
        cache: false,
        data: { classId: classId, companyId: companyId },
        success: function (data) {
            if (data && data.length > 0) {
                $.each(data, function (i, item) {
                    $("#FK_StudentId").append(
                        $('<option></option>').val(item.ID).html(item.Value)
                    );
                });
            }

            // Restore selected student if editing
            if ($('#hdnStudentId').val() && $('#hdnStudentId').val() !== '0') {
                $('#FK_StudentId').val($('#hdnStudentId').val()).attr("selected", "selected");
            }
        },
        error: function (xhr, status, error) {
            console.log("Error loading students:", error);
        }
    });
}
    </script>
}
