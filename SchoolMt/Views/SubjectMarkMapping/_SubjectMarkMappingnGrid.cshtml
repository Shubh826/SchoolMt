@model IEnumerable<MDL.SubjectMarkMappingMDL>

@{
    var objPagingmdl = (MDL.Common.BasicPagingMDL)ViewBag.paging;
    int SerialNo = (objPagingmdl.CurrentPage - 1) * objPagingmdl.RowParPage + 1;
}

<style>
    #tbl {
        margin-top: -3px;
    }
</style>

<div class="table-responsive" style="max-height: 450px; overflow-y: auto;">
    <table cellspacing="0" cellpadding="0" border="0" class="table table-bordered table-hover" id="tbl">
        <thead>
            <tr>
                <th class="text-center">Sr. No.</th>
                <th class="text-center">School Name</th>
                <th class="text-center">Class Name</th>
                <th class="text-center">Student Name</th>
                <th class="text-center">Exam Category</th>
                <th class="text-center">Exam Type</th>
                <th class="text-center">Created By</th>
                <th class="text-center">Created Date</th>
                <th class="text-center">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-danger">No Record Found</td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
        <tr>
            <td class="text-center">@SerialNo</td>
            <td class="text-center">@Html.DisplayFor(modelItem => item.CompanyName)</td>
            <td class="text-center">@Html.DisplayFor(modelItem => item.ClassName)</td>
            <td class="text-center">@Html.DisplayFor(modelItem => item.StudentName)</td>
            <td class="text-center">@Html.DisplayFor(modelItem => item.ExamCategory)</td>
            <td class="text-center">@Html.DisplayFor(modelItem => item.ExamType)</td>
            <td class="text-center">@Html.DisplayFor(modelItem => item.CreatedBy)</td>
            <td class="text-center">@Html.DisplayFor(modelItem => item.CreatedDate)</td>
            <td class="text-center">
                <a class="btn btn-primary" href="@Url.Action("AddEditSubjectMarkMappingData", "SubjectMarkMapping", new { id = item.PKId })">Edit</a>
                <a class="btn btn-danger marb10" href="javascript:void(0)" onclick="DeleteData(@item.PKId); return false;">Delete</a>
                <a class="btn btn-primary" href="@Url.Action("StudentReportCardDetails", new { id=item.FK_StudentId })">View Report Card</a><br />
            </td>
        </tr>
                    SerialNo++;
                }
            }
        </tbody>
    </table>
</div>

@Html.Partial("_Paging", (MDL.Common.BasicPagingMDL)ViewBag.paging)

<script type="text/javascript">
    function DeleteData(pkId) {
        if (!confirm("Are you sure you want to delete this record?")) return;

        $.ajax({
            url: '@Url.Action("DeleteSchoolConfigurationData", "SubjectMarkMapping")',
            type: 'POST',
            data: { pkId: pkId },
            success: function (data) {
                if (data.Message_Id == 1) {
                    alert("Deleted successfully!");
                    location.reload(); // you can optimize by removing the row instead of reloading
                } else {
                    alert("Error deleting records.");
                }
            },
            error: function (xhr) {
                alert("Error: " + xhr.responseText);
            }
        });
    }
</script>
