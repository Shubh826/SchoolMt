    }

        .header-info td {
            border: none !important;
            padding: 2px 5px;
            text-align: left;
            font-size: 12px;
        }

    .school-header {
        text-align: center;
        line-height: 1.2;
        margin-bottom: 5px;
        position: relative;
        padding: 0 80px;
    }

        .school-header h1 {
            margin: 0;
            font-size: 24px;
            color: #000080;
            font-weight: 900;
        }

        .school-header h2 {
            margin: 0;
            font-size: 14px;
            font-style: italic;
            color: #cc0000;
        }

        .school-header img {
            height: 60px;
            position: absolute;
            top: 0;
        }

        .school-header .logo-left {
            left: 0;
            border-radius: 50%;
        }

        .school-header .logo-right {
            right: 0;
        }

        .school-header p {
            font-size: 10px;
            margin: 2px 0;
        }

    hr {
        border: 0;
        border-top: 1px solid #333;
        margin: 10px 0;
    }

    .title-bar {
        background-color: #e0e0e0;
        font-weight: bold;
        padding: 5px;
        margin: 10px 0;
        border: 1px solid #999;
        text-align: center;
        font-size: 16px;
    }

    /* ---------------------- STUDENT INFO STYLES ---------------------- */
    .student-details-table {
        width: 100%;
        border-collapse: collapse;
    }

        .student-details-table td {
            border: none !important;
            padding: 2px 5px;
            font-size: 14px;
            vertical-align: top;
        }

            .student-details-table td:nth-child(1) {
                width: 15%;
                font-weight: normal;
            }

        .student-details-table .photo-cell {
            width: 25%;
            text-align: right; /* Align photo to the right */
            padding-right: 15px;
        }

    .student-photo {
        width: 100px;
        height: 120px;
        border: 1px solid #333;
        display: inline-block;
        margin-left: auto; /* Push photo right */
    }

    .class-info-cell {
        /* Style for the consolidated class, sec, roll row */
        display: inline-block;
        font-weight: bold;
    }

        .class-info-cell span {
            font-weight: normal;
            margin-left: 15px;
        }

    /* ---------------------- MARKS TABLE STYLES (CORRECTED) ---------------------- */
    .marks-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
        font-size: 12px;
    }

        .marks-table th, .marks-table td {
            border: 1px solid #999;
            padding: 2px 1px;
            text-align: center;
            line-height: 1.1;
        }

        .marks-table th {
            background-color: #f8f8f8;
            font-weight: bold;
            vertical-align: middle;
            white-space: nowrap;
            font-size: 10px; /* Base font for top headers */
        }

        .marks-table thead .sub-header th {
            font-size: 8px; /* Smallest font for (in 10) etc. */
            padding: 1px 0;
        }

        .marks-table td:first-child {
            text-align: left;
            padding-left: 5px;
            font-weight: bold;
            width: 15%; /* Subject name width */
        }

    /* ---------------------- FOOTER STYLES ---------------------- */
    .overall-summary td {
        border: none !important;
        padding: 5px;
        font-weight: bold;
    }

    .signature-row td {
        border-top: 1px solid #333 !important;
        padding-top: 5px;
        font-size: 12px;
        text-align: center;
    }
</style>


