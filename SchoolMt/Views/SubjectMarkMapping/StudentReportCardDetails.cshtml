@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <script type="text/javascript">
    $(document).ready(function (e) {
        $('#printReportCard').click(function (e) {
            PrintReportcard(e);
        });
        $('#downloadReportCard').click(function (e) {
            DownLoadReportcard(e);
        });
    });
        function downloadPDF() {
            const element = document.querySelector('.report-card'); // Select your report card div
            const opt = {
                margin: 0.5,
                filename: 'ReportCard.pdf',
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2 },
                jsPDF: { unit: 'in', format: 'a4', orientation: 'portrait' }
            };
            html2pdf().set(opt).from(element).save();
        }
    function PrintReportcard(e) {
        debugger;
        e.preventDefault(); // prevent full form submission
        var studentId = $('#hdnstudentId').val();
        if (!studentId) {
            alert('Student ID not found.');
            return;
        }

    $.ajax({
         url: '@Url.Action("PrintReportcard", "SubjectMarkMapping")',
        cache: false,
        contentType: "application/json; charset=utf-8",
        data: { 'id': studentId },

        success: function (data) {
            debugger;
            var htmlContent = data;

            var printFrame = document.createElement('iframe');
            printFrame.style.display = 'none';

            document.body.appendChild(printFrame);
            var printDocument = printFrame.contentDocument;

            printDocument.write(htmlContent);
            printDocument.close();

            printFrame.onload = function () {
                printFrame.contentWindow.focus();
                printFrame.contentWindow.print();

                // ✅ Fallback: wait for print to complete, then redirect
               // setTimeout(function () {
                  //  window.location.href = '@Url.Action("StudentReportCardDetails", "SubjectMarkMapping")';
               // }, 1000); // 1 second delay — you can increase if needed
            };
        },
        error: function (xhr) {
            alert("Error generating receipt.");
        },
        failure: function (res) {
            alert("Failed to generate receipt.");
        },
    });
}

function DownLoadReportcard() {
    var studentId = $('#hdnstudentId').val();
    // Directly open the controller action that returns PDF
    window.location.href = '/SubjectMarkMapping/DownloadReportCard?id=' + studentId;
}

    </script>
}
