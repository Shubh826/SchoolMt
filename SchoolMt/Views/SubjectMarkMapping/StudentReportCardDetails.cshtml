@model MDL.MarksTableViewModel
@{
    ViewBag.Title = "StudentReportCardDetails";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    body {
        font-family: Helvetica,Arial,sans-serif;
        font-size: 8pt;
        line-height: 10pt;
        padding: 10pt;
        background-color: #f4f4f4;
    }

    .borLeft {
        border-left: 1px solid #000000;
    }

    .borRight {
        border-right: 1px solid #000000;
    }

    .borTop {
        border-top: 1px solid #000000;
    }

    .borBottom {
        border-bottom: 1px solid #000000;
    }

    /**Start:Print and download css*/
    .action-buttons {
        text-align: center;
        margin: 15px 0;
    }

    .btn-print, .btn-download {
        display: inline-block;
        padding: 8px 16px;
        margin: 5px;
        border: none;
        border-radius: 6px;
        font-size: 14px;
        cursor: pointer;
        color: white;
    }

    .btn-print {
        background-color: #28a745; /* green */
    }

        .btn-print:hover {
            background-color: #218838;
        }

    .btn-download {
        background-color: #007bff; /* blue */
    }

        .btn-download:hover {
            background-color: #0056b3;
        }

    /* Hide both buttons while printing */
    @@media print {
        .action-buttons {
            display: none;
        }
    }
</style>
<div class="action-buttons">
    <a href="@Url.Action("Index", "SubjectMarkMapping")"
       class="btn btn-danger marb10">Back
    </a>    <button onclick="window.print()" class="btn-print">🖨️ Print Report Card</button>
</div>

<table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-family: Helvetica, Arial, sans-serif;font-size:8pt;line-height:10pt;">
    <tbody>
        <tr>
            <td colspan="4" align="center" style="font-family: Helvetica, Arial, sans-serif;font-size:12pt;line-height:14pt;"><strong>REPORT CARD @Model.Student.AcademicYear</strong></td>
        </tr>
        <tr>
            <td colspan="4" style="font-family: Helvetica, Arial, sans-serif;font-size:8pt;line-height:10pt;">&nbsp;</td>
        </tr>
        <tr>
            <td class="borLeft borTop" colspan="2" style="font-family: Helvetica, Arial, sans-serif;font-size:8pt;line-height:10pt;">
                <table width="100%" border="0" cellspacing="0" cellpadding="3">
                    <tbody>
                        <tr>
                            <td style="font-family: Helvetica, Arial, sans-serif;font-size:8pt;line-height:10pt;">Student's Name: <strong>@Model.Student.StudentName</strong></td>
                        </tr>
                        <tr>
                            <td style="font-family: Helvetica, Arial, sans-serif;font-size:8pt;line-height:10pt;">Father's Name: <strong>@(Model.Student.FatherName ?? "-")</strong></td>
                        </tr>
                        <tr>
                            <td style="font-family: Helvetica, Arial, sans-serif;font-size:8pt;line-height:10pt;">Mother's Name: <strong>@(Model.Student.MotherName ?? "-")</strong></td>
                        </tr>
                        <tr>
                            <td style="font-family: Helvetica, Arial, sans-serif;font-size:8pt;line-height:10pt;">Date Of Birth: <strong>@(Model.Student.DOB != null ? Model.Student.DOB : "-")</strong></td>
                        </tr>
                        <tr>
                            <td style="font-family: Helvetica, Arial, sans-serif;font-size:8pt;line-height:10pt;">
                                <table width="70%" border="0" cellspacing="0" cellpadding="0">
                                    <tbody>
                                        <tr>
                                            <td width="45%" style="font-family: Helvetica, Arial, sans-serif;font-size:8pt;line-height:10pt;">Class: <strong>@(Model.Student.Class ?? "-")</strong></td>
                                            <td width="25%" style="font-family: Helvetica, Arial, sans-serif;font-size:8pt;line-height:10pt;">Sec: <strong>@(Model.Student.Section ?? "-")</strong></td>
                                            <td width="30%" style="font-family: Helvetica, Arial, sans-serif;font-size:8pt;line-height:10pt;">Roll No: <strong>@(Model.Student.RollNo ?? "-")</strong></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
            <td align="right" class="borRight borTop" colspan="2" style="font-family: Helvetica, Arial, sans-serif;font-size:8pt;line-height:10pt;">
                <table border="0" cellspacing="5" cellpadding="0">
                    <tbody>
                        <tr>
                            <td><img src="@Model.Student.StudentImgUrl" alt="Student Photo" class="borBottom borLeft borRight borTop" width="80"></td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
        <tr>
            <td colspan="4" class="borTop borLeft borRight" style="font-family: Helvetica, Arial, sans-serif;font-size:8pt;line-height:10pt;">&nbsp;</td>
        </tr>
        <tr>
            <td colspan="4" class="borTop borLeft borRight" style="font-family: Helvetica, Arial, sans-serif;font-size:8pt;line-height:10pt;">
                <table width="100%" border="0" cellspacing="0" cellpadding="5">
                    <thead>

                        <tr>
                            <th class="borBottom borRight">Scholastic Areas:</th>
                            @foreach (var cat in Model.ExamCategories)
                            {
                                <th class="borBottom borRight" colspan="6">@cat.ExamCategoryType (100 marks)</th>
                            }
                            <th class="borBottom" colspan="2">OVERALL</th>
                        </tr>

                        <tr>
                            <th class="borBottom borRight" rowspan="2">Subject Name</th>

                            @foreach (var cat in Model.ExamCategories)
                            {

                                var examTypes = Model.ExamTypes.AsEnumerable();

                                if (cat.ExamCategoryType.Contains("Term-1") || cat.ExamCategoryType.Contains("Term 1"))
                                {
                                    // Term 1 → remove Yearly
                                    examTypes = examTypes.Where(e => e.ExamType != "Y");
                                }
                                else if (cat.ExamCategoryType.Contains("Term-2") || cat.ExamCategoryType.Contains("Term 2"))
                                {
                                    // Term 2 → remove Half-Yearly
                                    examTypes = examTypes.Where(e => e.ExamType != "HY");
                                }



                                foreach (var examType in examTypes)
                                {
                                    <th class="borBottom borRight">@examType.ExamType</th>
                                }

                                <th class="borBottom borRight">TOTAL</th>
                                <th rowspan="2" class="borBottom borRight">Grade</th>
                            }

                            <th class="borBottom borRight">GRAND TOTAL</th>
                            <th rowspan="2" class="borBottom">Grade</th>
                        </tr>

                        <tr>
                            @foreach (var cat in Model.ExamCategories)
                            {

                                var examTypes = Model.ExamTypes.AsEnumerable();

                                if (cat.ExamCategoryType.Contains("Term-1") || cat.ExamCategoryType.Contains("Term 1"))
                                {
                                    // Term 1 → remove Yearly
                                    examTypes = examTypes.Where(e => e.ExamType != "Y");
                                }
                                else if (cat.ExamCategoryType.Contains("Term-2") || cat.ExamCategoryType.Contains("Term 2"))
                                {
                                    // Term 2 → remove Half-Yearly
                                    examTypes = examTypes.Where(e => e.ExamType != "HY");
                                }


                                foreach (var examType in examTypes)
                                {
                                    <th class="borBottom borRight">(in @examType.TotalMark)</th>
                                }

                                <th class="borBottom borRight">(in 100)</th>
                            }
                            <th class="borBottom borRight">T1(50)+T2(50)</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var subject in Model.Subjects)
                        {
                            <tr>
                                <td class="borBottom borRight"><strong>@subject.SubjectName</strong></td>

                                @{
                                    double term1Total = 0;
                                    double term2Total = 0;
                                }

                                @foreach (var cat in Model.ExamCategories)
                                {
                                    int termTotal = 0;
                                    int termMax = 100;


                                    var examTypes = Model.ExamTypes.AsEnumerable();

                                    if (cat.ExamCategoryType.Contains("Term 1") || cat.ExamCategoryType.Contains("1"))
                                    {

                                        examTypes = examTypes.Where(e => e.ExamType != "Y");

                                    }
                                    else if (cat.ExamCategoryType.Contains("Term 2") || cat.ExamCategoryType.Contains("2"))
                                    {

                                        examTypes = examTypes.Where(e => e.ExamType != "HY");
                                    }


                                    foreach (var examType in examTypes)
                                    {
                                        var mark = Model.Marks.FirstOrDefault(m =>
                                            m.SubjectId == subject.Id &&
                                            m.ExamCategoryId == cat.Id &&
                                            m.ExamTypeId == examType.Id);

                                        if (mark != null)
                                        {
                                            <td class="borBottom borRight">@mark.ObtainMarks</td>
                                            termTotal += mark.ObtainMarks;
                                        }
                                        else
                                        {
                                            <td class="borBottom borRight">-</td>
                                        }
                                    }

                                    termTotal = termTotal > 100 ? 100 : termTotal;
                                    <td class="borBottom borRight">@termTotal</td>

                                    double termPercentage = (termTotal * 100.0) / termMax;
                                    var grade = Model.Grades.FirstOrDefault(g => termPercentage >= g.Min && termPercentage <= g.Max);

                                    <td class="borBottom borRight">@(grade.GradeName)</td>

                                    if (cat.ExamCategoryType.Contains("Term 1") || cat.ExamCategoryType.Contains("1"))
                                    {
                                        term1Total = termTotal;
                                    }

                                    else if (cat.ExamCategoryType.Contains("Term 2") || cat.ExamCategoryType.Contains("2"))
                                    {
                                        term2Total = termTotal;
                                    }

                                }

                                @{
                                    double overallTotal = (term1Total * 0.5) + (term2Total * 0.5);
                                    var overallGrade = Model.Grades.FirstOrDefault(g => overallTotal >= g.Min && overallTotal <= g.Max);
                                }

                                <td class="borBottom borRight">@overallTotal.ToString("F0")</td>
                                <td class="borBottom">@(overallGrade==null?"-": overallGrade.GradeName)</td>

                            </tr>
                        }

                    </tbody>
                </table>

            </td>
        </tr>
        <tr>
            <td colspan="4" class="borTop borLeft borRight" style="font-family: Helvetica, Arial, sans-serif;font-size:8pt;line-height:10pt;">&nbsp;</td>
        </tr>
        <tr>
            <td colspan="4" class="borTop borLeft borRight" style="font-family: Helvetica, Arial, sans-serif;font-size:8pt;line-height:10pt;">
                <table border="0" cellspacing="5" cellpadding="0" width="100%">
                    <tbody>
                        <tr>
                            <td width="25%" style="font-family: Helvetica, Arial, sans-serif;font-size:8pt;line-height:10pt;"><strong>8 Point Grading Scale:</strong></td>
                            <td width="75%" style="font-family: Helvetica, Arial, sans-serif;font-size:8pt;line-height:10pt;">
                                <strong>
                                    @{
                                        var grades = Model.Grades.OrderByDescending(g => g.Min).ToList();
                                        for (int i = 0; i < grades.Count; i++)
                                        {
                                            var grade = grades[i];
                                            <text>@grade.GradeName (@grade.Min% - @grade.Max%)</text>
                                            if (i < grades.Count - 1)
                                            {
                                                <text> </text>
                                            }
                                        }
                                    }
                                </strong>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
        <tr>
            <td colspan="4" class="borTop borLeft borRight" style="font-family: Helvetica, Arial, sans-serif;font-size:8pt;line-height:10pt;">&nbsp;</td>
        </tr>
        <tr>
            <td colspan="4" class="borTop borLeft borRight" style="font-family: Helvetica, Arial, sans-serif;font-size:8pt;line-height:10pt;">
