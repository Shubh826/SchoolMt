@model MDL.MarksTableViewModel
@{
    ViewBag.Title = "StudentReportCardDetails";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ---------------------- GLOBAL & CONTAINER STYLES ---------------------- */
    body {
        font-family: sans-serif;
        margin: 0;
        padding: 0;
        background-color: #f4f4f4;
    }

    .report-card {
        border: 2px solid #000;
        padding: 10px 20px 20px 20px;
        /* FINAL WIDTH: Set to a standard size that accommodates the corrected table */
        width: 800px;
        margin: 20px auto;
        background-color: white;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        font-size: 14px;
    }

    /* ---------------------- HEADER STYLES ---------------------- */
    .header-info {
        width: 100%;
        border-collapse: collapse;
    }

        .header-info td {
            border: none !important;
            padding: 2px 5px;
            text-align: left;
            font-size: 12px;
        }

    .school-header {
        text-align: center;
        line-height: 1.2;
        margin-bottom: 5px;
        position: relative;
        padding: 0 80px;
    }

        .school-header h1 {
            margin: 0;
            font-size: 24px;
            color: #000080;
            font-weight: 900;
        }

        .school-header h2 {
            margin: 0;
            font-size: 14px;
            font-style: italic;
            color: #cc0000;
        }

        .school-header img {
            height: 60px;
            position: absolute;
            top: 0;
        }

        .school-header .logo-left {
            left: 0;
            border-radius: 50%;
        }

        .school-header .logo-right {
            right: 0;
        }

        .school-header p {
            font-size: 10px;
            margin: 2px 0;
        }

    hr {
        border: 0;
        border-top: 1px solid #333;
        margin: 10px 0;
    }

    .title-bar {
        background-color: #e0e0e0;
        font-weight: bold;
        padding: 5px;
        margin: 10px 0;
        border: 1px solid #999;
        text-align: center;
        font-size: 16px;
    }

    /* ---------------------- STUDENT INFO STYLES ---------------------- */
    .student-details-table {
        width: 100%;
        border-collapse: collapse;
    }

        .student-details-table td {
            border: none !important;
            padding: 2px 5px;
            font-size: 14px;
            vertical-align: top;
        }

            .student-details-table td:nth-child(1) {
                width: 15%;
                font-weight: normal;
            }

        .student-details-table .photo-cell {
            width: 25%;
            text-align: right; /* Align photo to the right */
            padding-right: 15px;
        }

    .student-photo {
        width: 100px;
        height: 120px;
        border: 1px solid #333;
        display: inline-block;
        margin-left: auto; /* Push photo right */
    }

    .class-info-cell {
        /* Style for the consolidated class, sec, roll row */
        display: inline-block;
        font-weight: bold;
    }

        .class-info-cell span {
            font-weight: normal;
            margin-left: 15px;
        }

    /* ---------------------- MARKS TABLE STYLES (CORRECTED) ---------------------- */
    .marks-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
        font-size: 12px;
    }

        .marks-table th, .marks-table td {
            border: 1px solid #999;
            padding: 2px 1px;
            text-align: center;
            line-height: 1.1;
        }

        .marks-table th {
            background-color: #f8f8f8;
            font-weight: bold;
            vertical-align: middle;
            white-space: nowrap;
            font-size: 10px; /* Base font for top headers */
        }

        .marks-table thead .sub-header th {
            font-size: 8px; /* Smallest font for (in 10) etc. */
            padding: 1px 0;
        }

        .marks-table td:first-child {
            text-align: left;
            padding-left: 5px;
            font-weight: bold;
            width: 15%; /* Subject name width */
        }

    /* ---------------------- FOOTER STYLES ---------------------- */
    .overall-summary td {
        border: none !important;
        padding: 5px;
        font-weight: bold;
    }

    .signature-row td {
        border-top: 1px solid #333 !important;
        padding-top: 5px;
        font-size: 12px;
        text-align: center;
    }
</style>


<div class="report-card">

    <table class="header-info">
        <tr>
            <td style="width: 30%;">Affiliation No.  @Model.Student.AffiliationNo</td>
            <td style="width: 40%; text-align: center; font-size: 12px;">From Darkness to Light</td>
            <td style="width: 30%; text-align: right;">School Code: @Model.Student.SchoolCode</td>
        </tr>
    </table>

    <div class="school-header">
        <img src="@Model.Student.SchoolLogoUrl" alt="School Logo" class="logo-left">
        <img src="@Model.Student.SchoolLogoUrl" alt="School Insignia" class="logo-right">
        <h1>@Model.Student.SchoolName</h1>
        <h2>@Model.Student.SchoolAddress - @Model.Student.SchoolPin</h2>
        @*<h2>PATTI - PRATAPGARH - U.P. - PIN - 230135</h2>*@
        <p>Affiliated to C.B.S.E., New Delhi</p>
        <p>Web: @Model.Student.SchoolWebSiteUrl, E-mail: @Model.Student.SchoolEmailId, Phone: @Model.Student.SchoolPhone, Mob.:@Model.Student.SchoolMobileNo</p>
    </div>

    <hr>

    <div class="title-bar">
        REPORT CARD @Model.Student.AcademicYear
    </div>

    <table class="student-details-table">
        <tr>
            <td>Student's Name:</td>
            <td><strong>@Model.Student.StudentName</strong></td>
            <td rowspan="5" class="photo-cell">
                <img src="@Model.Student.StudentImgUrl" alt="Student Photo" class="student-photo">
            </td>
        </tr>
        <tr>
            <td>Father's Name:</td>
            <td>@(Model.Student.FatherName != null ? Model.Student.FatherName : "-")</td>
        </tr>
        <tr>
            <td>Mother's Name:</td>
            <td>@(Model.Student.MotherName != null ? Model.Student.MotherName : "-")</td>
        </tr>
        <tr>
            <td>Date Of Birth:</td>
            <td>@(Model.Student.DOB != null ? Model.Student.DOB : "-")</td>
        </tr>
        <tr class="class-row">
            <td>Class:</td>
            <td colspan="2">
                <span class="class-info-cell">
                    @(Model.Student.Class != null ? Model.Student.Class : "-")
                    <span>Sec:</span>    @(Model.Student.Section != null ? Model.Student.Section : "-")
                    <span>Roll No:</span> @(Model.Student.RollNo != null ? Model.Student.RollNo : "-")
                </span>
            </td>
        </tr>
    </table>

    @*<h3 style="margin-top: 20px; margin-bottom: 5px; font-size: 14px;">Scholastic Areas:</h3>*@


    <table class="marks-table">
        <thead>
            <tr>
                <th rowspan="2" style="width: 15%; border: 1px solid black; background-color: #f2f2f2;">Scholastic Areas:</th>
                @foreach (var cat in Model.ExamCategories)
                {
                    <th colspan="@(Model.ExamTypes.Count + 2)" style="border: 1px solid black; background-color: #f2f2f2;">@cat.ExamCategoryType (100 marks)</th>
                }
                <th colspan="2" style="border: 1px solid black; background-color: #f2f2f2;">OVERALL</th>
            </tr>
            <tr class="sub-header" style="background-color: #f2f2f2;">
                @foreach (var cat in Model.ExamCategories)
                {
                    foreach (var examType in Model.ExamTypes)
                    {
                        <th style="border: 1px solid black;">@examType.ExamType<br>(in @examType.TotalMark)</th>
                    }
                    <th style="border: 1px solid black;">TOTAL<br>(in 100)</th>
                    <th style="border: 1px solid black;">Grade</th>
                }
                <th style="border: 1px solid black;">GRAND TOTAL<br>T1(50)+T2(50)</th>
                <th style="border: 1px solid black;">Grade</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var subject in Model.Subjects)
            {
                <tr>
                    <td><strong>@subject.SubjectName</strong></td>

                    @foreach (var cat in Model.ExamCategories)
                    {
                        int termTotal = 0;

                        foreach (var examType in Model.ExamTypes)
                        {
                            var mark = Model.Marks.FirstOrDefault(m =>
                                m.SubjectId == subject.Id &&
                                m.ExamCategoryId == cat.Id &&
                                m.ExamTypeId == examType.Id);

                            if (mark != null)
                            {
                                <td>@mark.ObtainMarks</td>
                                termTotal += mark.ObtainMarks;
                            }
                            else
                            {
                                <td>-</td>
                            }
                        }

                        <td>@termTotal</td>

                        var grade = Model.Grades.FirstOrDefault(g => termTotal >= g.Min && termTotal <= g.Max);

                        <td>@(grade != null ? grade.GradeName : "-")</td>
                    }

                    @* Overall Total for Subject *@
                    @{
                        int overall = Model.ExamCategories.Sum(cat =>
                            Model.Marks
                                .Where(m => m.SubjectId == subject.Id && m.ExamCategoryId == cat.Id)
                                .Sum(m => m.ObtainMarks)
                        );
                        var overallGrade = Model.Grades.FirstOrDefault(g => overall >= g.Min && overall <= g.Max);
                    }
                    <td>@overall</td>
                    <td>@(overallGrade != null ? overallGrade.GradeName : "-")</td>
                </tr>
            }
        </tbody>
    </table>




    @*<h3 style="margin-top: 20px; margin-bottom: 5px; font-size: 14px;">8 Point Grading Scale:</h3>*@
    @*<table class="grade-scale">
            <tr>
                <td>A1 (91% - 100%),</td>
                <td>A2 (81% - 90%),</td>
                <td>B1 (71% - 80%),</td>
                <td>B2 (61% - 70%),</td>
                <td>C1 (51% - 60%),</td>
            </tr>

            <tr><td>C2 (41% - 50%),</td>
                <td>D (33% - 40%),</td>
                <td colspan="3">E (32% and below)</td>
            </tr>
        </table>*@
    <!-- Grading Scale and Abbreviations -->
    <table class="grade-scale" cellspacing="0" cellpadding="5" style="width: 100%; border-collapse: collapse; font-family: Arial, sans-serif; margin-top: 10px;">
        @{
            var grades = Model.Grades.OrderByDescending(g => g.Min).ToList();
        }
        <tr>
            <td style="border: 1px solid black; width: 23%; font-weight: bold; vertical-align:middle;">8 Point Grading Scale:</td>
            <td style="border: 1px solid black; width: 77%; padding: 8px;">
                @for (int i = 0; i < grades.Count; i++)
                {
                    var grade = grades[i];

                    <text>@grade.GradeName (@grade.Min% - @grade.Max%)</text>
                }
            </td>
        </tr>
    </table>



    <!-- Abbreviations Table -->
    <table class="header-info" border="1" cellspacing="0" cellpadding="5" style="width: 100%; border-collapse: collapse; font-family: Arial, sans-serif; margin-top: 10px;">
        <tr>
            <td style="border: 1px solid black; width: 15%; font-weight: bold;">Abbreviations:</td>
            <td style="border: 1px solid black; width: 85%;"> @Model.Student.AbbreviationText</td>
        </tr>
    </table>

    <table class="header-info overall-summary" style="border: 1px solid #333;">
        <tr>

            <td style="width: 10%; background-color: #f0f0f0;"><strong>Overall:</strong></td>
            <td style="width: 25%;">Marks: </td>
            <td style="width: 30%;"><strong>Percentage: @Model.Student.Percentages</strong></td>
            <td style="width: 35%;"><strong>Grade: @Model.Student.Grade</strong></td>
        </tr>
    </table>

    <!-- Overall Summary -->
    <table border="1" cellspacing="0" cellpadding="5" style="width: 100%; border-collapse: collapse; font-family: Arial, sans-serif; margin-top: 10px;">
        <tr>
            <td style="border: 1px solid black; width: 15%; background-color: #f2f2f2; font-weight: bold;">Overall:</td>
            <td style="border: 1px solid black; width: 28%;">@Model.Student.ObtainMarks/@Model.Student.TotalMarks</td>
            <td style="border: 1px solid black; width: 28%;">Percentage: @Model.Student.Percentages</td>
            <td style="border: 1px solid black; width: 29%;">Grade:  @Model.Student.Grade</td>
        </tr>
    </table>

    <h3 style="margin-top: 20px; margin-bottom: 5px; font-size: 14px;">Co-Scholastic Areas: Term-1 [on a 3-point (A-C) grading scale]</h3>
    <table class="marks-table coscholastic-table" style="font-size: 12px;">
        <thead>
            <tr>
                <th style="width: 45%;">Co-Scholastic Areas: Term-1 [on a 3-point (A-C) grading scale]</th>
                <th style="width: 5%;">Grade</th>
                <th style="width: 45%;">Co-Scholastic Areas: Term-2 [on a 3-point (A-C) grading scale]</th>
                <th style="width: 5%;">Grade</th>
            </tr>
        </thead>
        <tbody>
            @*@foreach (var item in Model.CoScholasticList)
                {
                    <tr>
                        <td style="text-align:left;">@item.Area</td>
                        <td>@item.GradeTerm1</td>
                        <td style="text-align:left;">@item.Area</td>
                        <td>@item.GradeTerm2</td>
                    </tr>
                }*@
            <tr>
                <td style="text-align: left;">Work Education (or Pre-vocational Education)</td>
                <td>A</td>
                <td style="text-align: left;">Work Education (or Pre-vocational Education)</td>
                <td>A</td>
            </tr>
            <tr>
                <td style="text-align: left;">Art Education</td>
                <td>A</td>
                <td style="text-align: left;">Art Education</td>
                <td>A</td>
            </tr>
            <tr>
                <td style="text-align: left;">Health & Physical Education</td>
                <td>A</td>
                <td style="text-align: left;">Health & Physical Education</td>
                <td>A</td>
            </tr>
            <tr>
                <td style="text-align: left;">Discipline: Term-1</td>
                <td>Grade</td>
                <td style="text-align: left;">Discipline: Term-2</td>
                <td>Grade</td>
            </tr>
            <tr>
                <td style="text-align: left;">[on a 3-point (A-C) grading scale]</td>
                <td>A</td>
                <td style="text-align: left;">[on a 3-point (A-C) grading scale]</td>
                <td>A</td>
            </tr>
        </tbody>
    </table>

    <table class="header-info" style="margin-top: 15px; font-size: 12px;">
        <tr>
            @*<td style="width: 20%;">Attendance: 54</td>*@
            @*<td style="width: 50%;">Remarks/Status: Need Improvement</td>*@
            <td style="width: 50%;">Remarks/Status: @Model.Student.ResultRemark</td>
            @*<td style="width: 30%; text-align: right;"><strong>Promoted to Class: VII</strong></td>*@
        </tr>
    </table>

    <table class="header-info signature-row" style="margin-top: 40px;">
        <tr>
            <td style="width: 30%; text-align: left;">Date:@DateTime.Now.ToString("dd-MM-yyyy")</td>
            <td style="width: 35%; text-align: center;">Signature of Class Teacher</td>
            <td style="width: 35%; text-align: right;">Principal's Signature</td>
        </tr>
    </table>

</div>

