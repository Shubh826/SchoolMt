@model MDL.LoginMDL
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - True Sunshine Academy</title>

    <!-- Fonts and Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

    @*<link href="~/assets/css/font-swap.css" rel="stylesheet" />
    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/css/bootstrap-icons.css" rel="stylesheet" />*@

    <!-- Custom CSS -->
    <link rel="shortcut icon" href="~/assets/images/favicon.png" type="image/x-icon">
    <style>
        * {
            box-sizing: border-box;
        }

        body, html {
            height: 100%;
            margin: 0;
            font-family: 'Nunito', sans-serif;
            overflow: hidden;
        }

        .background-slider {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
        }

        .carousel-item,
        .carousel-inner,
        .carousel-item img {
            height: 100vh;
            width: 100%;
            object-fit: cover;
        }

        .login-container {
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            z-index: 10;
        }

        .login-box {
            background: rgba(0, 0, 0, 0.4); /* Darker background */
            backdrop-filter: blur(12px);
            padding: 2.5rem;
            width: 100%;
            max-width: 400px;
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .form-control {
            background-color: rgba(255, 255, 255, 0.2);
            border: none;
            color: #fff;
        }

            .form-control::placeholder {
                color: #eee;
            }

            .form-control:focus {
                background-color: rgba(255, 255, 255, 0.3);
                box-shadow: none;
                color: #fff;
            }

        .form-control-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #fff;
        }

        .position-relative input {
            padding-left: 2.5rem !important;
        }

        .btn-primary {
            background-color: #0d6efd;
            border: none;
        }

            .btn-primary:hover {
                background-color: #0b5ed7;
            }

        .text-muted,
        .text-muted a {
            color: #ddd !important;
        }

        .alert {
            background-color: rgba(255, 0, 0, 0.1);
            color: white;
            border: none;
        }

        @@media (max-width: 576px) {
            .login-box {
                padding: 2rem 1.5rem;
                border-radius: 15px;
            }
        }
    </style>
</head>
<body>
    <!-- Background Image Slider -->
    <div id="backgroundSlider" class="carousel slide background-slider" data-bs-ride="carousel" data-bs-interval="3000">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/assets/images/Slide-1.jpg" class="d-block w-100" alt="Slide 1">
            </div>
            <div class="carousel-item">
                <img src="~/assets/images/Slide-2.jpg" class="d-block w-100" alt="Slide 2">
            </div>
            <div class="carousel-item">
                <img src="~/assets/images/Slide-3.jpg" class="d-block w-100" alt="Slide 3">
            </div>
        </div>
    </div>

    <!-- Login Form -->
    <div class="login-container">
        <div class="login-box text-center">
            <img src="~/assets/images/logo/logo.png" alt="Logo" style="height: 50px;">
            <h3 class="mt-3 text-white">Log in</h3>
            <p class="text-muted">Welcome to True Sunshine Academy</p>

            @if (ViewBag.Message != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>@ViewBag.Message</strong>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @using (Html.BeginForm("Login", "Home", FormMethod.Post, new { @class = "form-horizontal" }))
            {
                <div class="form-group position-relative mb-3 text-start">
                    @Html.TextBoxFor(m => m.UserName, new
                    {
                        @class = "form-control form-control-lg",
                        @placeholder = "Username",
                        @maxlength = "30",
                        @autocomplete = "off"
                    })
                    <div class="form-control-icon"><i class="bi bi-person"></i></div>
                    @Html.ValidationMessageFor(m => m.UserName, null, new { @class = "text-danger" })
                </div>

                <div class="form-group position-relative mb-3 text-start">
                    @Html.PasswordFor(m => m.Password, new
                    {
                        @class = "form-control form-control-lg",
                        @placeholder = "Password",
                        @maxlength = "50"
                    })
                    <div class="form-control-icon"><i class="bi bi-shield-lock"></i></div>
                    @Html.ValidationMessageFor(m => m.Password, null, new { @class = "text-danger" })
                </div>

                <div class="form-check d-flex align-items-center mb-3 text-start">
                    @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input me-2", @id = "flexCheckDefault" })
                    <label class="form-check-label" for="flexCheckDefault">Keep me logged in</label>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-lg shadow">Log In</button>
                </div>
            }

            <div class="text-center mt-4">
                <p class="text-muted mb-1">
                    Don't have an account?
                    <a href="@Url.Action("SignUp", "Home")" class="text-white text-decoration-underline">Sign up</a>
                </p>
                <p>
                    <a href="@Url.Action("ForgetPassword", "Home")" class="text-white text-decoration-underline">Forgot password?</a>
                </p>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    @*<script src="~/assets/js/bootstrap.bundle.min.js"></script>*@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
