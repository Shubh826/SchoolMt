@model MDL.StudentFeeDetailsMDL

@{
    ViewBag.Title = "AddBulkStudentDetails";
    Layout = "~/Views/Shared/_Layout.cshtml";
}




<div class="page-heading mb-0">
    <div class="page-title">
        <div class="row">
            <div class="col-12 col-md-6 order-md-1 order-last">
                <h3>Add Student Fee Details</h3>
            </div>
            <div class="col-12 col-md-6 order-md-2 order-first">
                <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="">Dashboard</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Add Student Fee Details</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>
<div class="card shadow-sm rounded">
    <div class="card-content">
        <div class="card-body">
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    @using (Html.BeginForm("ValidateExcelData", "StudentFeeDetails", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        <div class="form-body">
                            <div class="row mb-3">
                                <div class="col-md-12 text-end">
                                    @Html.ActionLink("Download Format", "DownloadFile", "StudentFeeDetails", null, new { @class = "btn btn-primary" })
                                </div>
                            </div>

                            <div class="row mb-4 align-items-center">
                                <label class="col-md-3 col-form-label fw-bold">
                                    Upload File<span class="text-danger">*</span>
                                </label>
                                <div class="col-md-7">
                                    @Html.TextBoxFor(E => E.ExcelFile, new { @type = "file", @class = "form-control" })
                                    @Html.ValidationMessageFor(E => E.ExcelFile, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="row mt-4">
                                <div class="col-md-12 text-center">
                                    <button type="submit" id="btnsubmitBulk" class="btn btn-primary me-2">Submit</button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
                                </div>
                            </div>

                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>



@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
   
    <script type="text/javascript">

        $(document).ready(function (e) {

            $('#btnsubmitBulk').click(function (e) {
                var fileInput = $('input[type="file"]')[0];
                var filePath = fileInput.value;

                // Check if file is selected
                if (!filePath) {
                    alert("Please select an Excel file.");
                    e.preventDefault();
                    return false;
                }

                // Check Excel file extension
                var allowedExtensions = /(\.xls|\.xlsx)$/i;
                if (!allowedExtensions.exec(filePath)) {
                    alert("Please upload a valid Excel file (.xls or .xlsx).");
                    fileInput.value = ''; // Clear the file input
                    e.preventDefault();
                    return false;
                }

                // Optionally: show a loader here
                return true;
            });



        });

    </script>
}
