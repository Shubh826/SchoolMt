@model MDL.ExpenseMasterMDL
@{
    ViewBag.Title = "AddEditExpense";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

@using (Html.BeginForm("AddEditExpense", "ExpenseMaster"))
{
    @Html.HiddenFor(model => model.PK_ExpenseId)
    @*@Html.HiddenFor(model => model.HdnDate)*@


    <div class="page-heading mb-0">
        <div class="page-title">
            <div class="row">
                <div class="col-12 col-md-6 order-md-1 order-last">
                    <h3>Add Edit Expense</h3>
                </div>
                <div class="col-12 col-md-6 order-md-2 order-first text-end">
                    <nav aria-label="breadcrumb" class="breadcrumb-header">
                        <ol class="breadcrumb justify-content-end mb-0">
                            <li class="breadcrumb-item"><a href="">Dashboard</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Add Edit Expense</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-content">
            <div class="card-body">
                <div class="row">
                    <div class="col-lg-8 offset-lg-1">
                        <div class="form-body">
                            <div class="row">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                <!-- Expense Head Dropdown -->
                                <div class="col-md-3">
                                    <label class="setForm bold">Expense Head<span style="color:red">*</span></label>
                                </div>
                                <div class="col-md-7 form-group">
                                    @Html.DropDownListFor(model => model.FK_ExpenseHeadId,
                                        new SelectList((System.Collections.IEnumerable)ViewData["ExpenseHeadList"], "ID", "Value"),
                                        "--Select--",
                                        new { @class = "form-control select2" })
                                    @Html.ValidationMessageFor(model => model.FK_ExpenseHeadId, "", new { @class = "redText", style = "color:red" })
                                </div>

                                <!-- Date -->
                                <div class="col-md-3">
                                    <label class="setForm bold">Date<span style="color:red">*</span></label>
                                </div>
                                <div class="col-md-7 form-group">
                                    @Html.TextBoxFor(model => model.Date, new { @class = "form-control", maxlength = "200", @placeholder = "Date" })

                                    @*@Html.TextBoxFor(model => model.Date, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })*@
                                    @Html.ValidationMessageFor(model => model.Date, "", new { @class = "redText", style = "color:red" })
                                </div>

                                <!-- Amount -->
                                <div class="col-md-3">
                                    <label class="setForm bold">Amount<span style="color:red">*</span></label>
                                </div>
                                <div class="col-md-7 form-group">
                                    @Html.TextBoxFor(model => model.Amount, new { @class = "form-control", type = "number", @placeholder = "Amount" })
                                    @Html.ValidationMessageFor(model => model.Amount, "", new { @class = "redText", style = "color:red" })
                                </div>

                                <!-- Remarks -->
                                <div class="col-md-3">
                                    <label class="setForm bold">Remarks</label>
                                </div>
                                <div class="col-md-7 form-group">
                                    @Html.TextAreaFor(model => model.Remarks, new { @class = "form-control", @placeholder = "Remarks", maxlength = 150 })
                                    @Html.ValidationMessageFor(model => model.Remarks, "", new { @class = "redText", style = "color:red" })
                                </div>

                                <!-- Submit Button -->
                                <div class="col-sm-9 d-flex justify-content-end center">
                                    <button type="submit" class="btn btn-primary me-1 mb-1">Submit</button>
                                    <a href='@Url.Action("Index", "ExpenseMaster")' class="btn btn-light-secondary me-1 mb-1">Cancel</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <link href="~/assets/css/jquery-ui.css" rel="stylesheet" />
    <link href="~/assets/css/daterangepicker.css" rel="stylesheet" />
    <script src="~/assets/js/moment.min.js"></script>
    <script src="~/assets/js/daterangepicker.min.js"></script>
    <script src="~/assets/js/jquery-ui.js"></script>

    <script type="text/javascript">
        $(document).ready(function (e) {
            $('#Date').daterangepicker({
                singleDatePicker: true,
                showDropdowns: true,
                autoUpdateInput: true,
                opens: 'right',
                locale: {
                    //  format: 'YYYY-MM-DD'
                    format: 'DD-MM-YYYY'
                },
                maxDate: moment() // disable future dates
            });

        });
    </script>
}

