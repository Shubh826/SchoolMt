<style>
    .dataTables_info, .pagination .page-link {
        font-family: 'Nunito', sans-serif;
        font-size: 14px;
    }
</style>
<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

            <!-- Left Side: Page Info -->
            <div class="dataTables_info m-0" role="status" aria-live="polite">
                Page @Model.CurrentPage of @Model.TotalPage (@Model.TotalItem Records)
            </div>

            <!-- Right Side: Pagination -->
            <nav aria-label="Page navigation" style="margin-top: -8px;">
                <!-- Slightly raised -->
                <ul class="pagination pagination-sm mb-0 align-middle">

                    @{
                        int currentPage = Model.CurrentPage;
                        int totalPages = Model.TotalPage;
                        int maxShowPage = 5;

                        int startPage = ((currentPage - 1) / maxShowPage) * maxShowPage + 1;
                        int endPage = Math.Min(startPage + maxShowPage - 1, totalPages);

                        int previousPage = currentPage - 1;
                        int nextPage = currentPage + 1;
                    }

                    <!-- Previous -->
                    <li class="page-item @(previousPage < 1 ? "disabled" : "")">
                        <a class="page-link bg-light border" href="javascript:void(0);" onclick="paging(@previousPage)">
                            <strong>&laquo; Prev</strong>
                        </a>
                    </li>

                    <!-- Page Numbers -->
                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="javascript:void(0);" onclick="paging(@i)">@i</a>
                        </li>
                    }

                    <!-- Next -->
                    <li class="page-item @(nextPage > totalPages ? "disabled" : "")">
                        <a class="page-link bg-light border" href="javascript:void(0);" onclick="paging(@nextPage)">
                            <strong>Next &raquo;</strong>
                        </a>
                    </li>
                </ul>
            </nav>

        </div>
    </div>
</div>
