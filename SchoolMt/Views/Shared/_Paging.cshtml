@model MDL.Common.BasicPagingMDL

<div class="row">
    <div class="col-sm-12 col-md-5">
        <div class="dataTables_info" role="status" aria-live="polite">
            Page @Model.CurrentPage of @Model.TotalPage (@Model.TotalItem Records)
        </div>
    </div>
    <div class="col-sm-12 col-md-7">
        <div class="dataTables_paginate paging_simple_numbers">
            <ul class="pagination pagination-flat">
                @{
                    int currentPage = Model.CurrentPage;
                    int totalPages = Model.TotalPage;
                    int maxShowPage = 5;

                    int startPage = ((currentPage - 1) / maxShowPage) * maxShowPage + 1;
                    int endPage = Math.Min(startPage + maxShowPage - 1, totalPages);

                    int previousPage = currentPage - 1;
                    int nextPage = currentPage + 1;
                }

                <!-- Previous Button -->
                @if (previousPage >= 1)
                {
                    <li class="paginate_button page-item previous">
                        <a href="javascript:void(0);" onclick="paging(@previousPage)" class="page-link">Previous</a>
                    </li>
                }
                else
                {
                    <li class="paginate_button page-item previous disabled">
                        <a href="javascript:void(0);" class="page-link">Previous</a>
                    </li>
                }

                <!-- Page Numbers -->
                @for (int i = startPage; i <= endPage; i++)
                {
                    if (i == currentPage)
                    {
                        <li class="paginate_button page-item active">
                            <a href="javascript:void(0);" class="page-link">@i</a>
                        </li>
                    }
                    else
                    {
                        <li class="paginate_button page-item">
                            <a href="javascript:void(0);" onclick="paging(@i)" class="page-link">@i</a>
                        </li>
                    }
                }

                <!-- Next Button -->
                @if (nextPage <= totalPages)
                {
                    <li class="paginate_button page-item next">
                        <a href="javascript:void(0);" onclick="paging(@nextPage)" class="page-link">Next</a>
                    </li>
                }
                else
                {
                    <li class="paginate_button page-item next disabled">
                        <a href="javascript:void(0);" class="page-link">Next</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
