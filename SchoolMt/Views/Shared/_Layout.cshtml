        /*START:: FOR Menu Search*/
        /* Normal sidebar search */
        .sidebar-search-wrapper {
            padding: 10px 12px;
        }

        .sidebar-search {
            position: relative;
        }

            .sidebar-search input.form-control {
                height: 40px;
                padding-left: 2.5rem;
                border-radius: 999px;
                background-color: #f1f3f5;
                font-size: 14px;
                border: none;
                width: 100%;
                transition: all 0.3s ease;
            }

            .sidebar-search .search-icon {
                position: absolute;
                top: 50%;
                left: 16px;
                transform: translateY(-50%);
                font-size: 1.1rem;
                color: #6c757d;
            }

        /* Collapsed: hide input completely */
        .sidebar.collapsed .sidebar-search input.form-control {
            display: none;
        }

        /* Collapsed: icon shown standalone */
        .sidebar.collapsed .sidebar-search .search-icon {
            position: static;
            display: block;
            font-size: 1.5rem;
            margin: 0 auto;
            text-align: center;
            padding: 8px;
            background-color: #f1f3f5;
            border-radius: 50%;
            cursor: default;
        }
