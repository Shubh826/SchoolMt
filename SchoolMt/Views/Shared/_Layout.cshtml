    <script>

        $(document).ready(function () {

            // Submenu toggle arrow click
            $(document).on('click', '.iocn-link > a', function (e) {
                e.preventDefault();

                var parentLi = $(this).closest('li');
                var subMenu = parentLi.find('.sub-menu');

                // Toggle submenu visibility
                subMenu.slideToggle(200);
                parentLi.toggleClass('open');
            });

            // Search functionality
            $('#menuSearchInput').on('keyup', function () {
                var searchText = $(this).val().toLowerCase().trim();

                $('.nav-links > li').each(function () {
                    var parentLi = $(this);
                    var hasMatch = false;

                    // Loop through sub-menu items
                    parentLi.find('.sub-menu li').each(function () {
                        var menuItem = $(this);
                        var text = menuItem.text().toLowerCase().trim();

                        if (text.indexOf(searchText) !== -1) {
                            menuItem.show();
                            hasMatch = true;
                        } else {
                            menuItem.hide();
                        }
                    });

                    // Only hide parent if no sub-item matched
                    if (searchText === '') {
                        parentLi.show();
                        parentLi.find('.sub-menu li').show();
                    } else {
                        if (hasMatch) {
                            parentLi.show();
                        } else {
                            parentLi.hide();
                        }
                    }
                });
            });

        });

