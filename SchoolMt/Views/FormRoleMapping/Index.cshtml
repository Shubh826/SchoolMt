@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model MDL.FormMappingViewModel

<div id="main-content">
    <div class="page-heading">
        <div class="page-title">
            <div class="row">
                <div class="col-12 col-md-6 order-md-1 order-last">
                    <h3>Form Role Mapping</h3>
                </div>
            </div>
        </div>

        <section class="section">
            <div class="card">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Mapping For</label>
                        </div>
                        <div class="col-md-7">
                            @Html.DropDownListFor(E => E.MappingFor, new SelectList((IEnumerable<object>)ViewData["Mappinglist"], "MappingFor", "MappingFor"), new { @class = "form-control select2" })
                            @Html.ValidationMessageFor(E => E.MappingFor)
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-bold">Company Name</label>
                        </div>
                        <div class="col-md-7">
                            @Html.DropDownListFor(E => E.FK_CompanyID, new SelectList((IEnumerable<object>)ViewData["companylist"], "ID", "Value"), "--Select Company--", new { @class = "form-control select2" })
                            @Html.ValidationMessageFor(E => E.FK_CompanyID)
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-bold">Role</label>
                        </div>
                        <div class="col-md-7">
                            @Html.DropDownListFor(E => E.FK_RoleId, new SelectList((IEnumerable<object>)ViewData["Rolelist"], "ID", "Value"), "--Select Role--", new { @class = "form-control select2" })
                            @Html.ValidationMessageFor(E => E.FK_RoleId)
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-bold">Form</label>
                        </div>
                        <div class="col-md-7">
                            @Html.DropDownListFor(m => m.FK_FormId, ViewData["formSelectlist"] as SelectList, "--Select Form--", new { @class = "form-control select2" })
                        </div>
                    </div>

                    <!-- Hidden Fields -->
                    @Html.Hidden("hdncompanyId", Model.FK_CompanyID)
                    @Html.Hidden("hdnroleId", Model.FK_RoleId)
                    @Html.Hidden("hdnformId", Model.FK_FormId)

                    <!-- Partial Render -->
                    <div id="TableDiv">
                        @Html.Partial("_FormMapping", Model)
                    </div>

                    <!-- Message Box -->
                    <div class="row" style="margin-top:20px;">
                        <div id="msgDiv" class="col-12">
                            @if (ViewBag.msg != null && (ViewBag.msg).Message_Id == 1)
                            {
                                <div id="myAlert" class="alert alert-success">
                                    <a href="javascript:void(0)" class="close" data-dismiss="alert" aria-label="close" onclick="DivHide()">&times;</a>
                                    <strong>@ViewBag.msg.Message</strong>
                                </div>
                            }
                            else
                            {
                                if (ViewBag.msg != null)
                                {
                                    <div id="myAlert" class="alert alert-danger">
                                        <a href="javascript:void(0)" class="close" data-dismiss="alert" aria-label="close" onclick="DivHide()">&times;</a>
                                        <strong> @ViewBag.msg.Message</strong>
                                    </div>
                                }
                            }
                            <script>
                                setTimeout(function () {
                                    document.getElementById("msgDiv").style.display = "none";
                                }, 5000);
                            </script>
                        </div>
                    </div>

                    @*<div class="row mt-3">
            <div id="msgDiv">
                @if (ViewBag.msg != null)
                {
                    if (ViewBag.msg.Message_Id == 1)
                    {
                        <div class="alert alert-success">
                            <a href="javascript:void(0)" class="close" onclick="DivHide()">&times;</a>
                            <strong>@ViewBag.msg.Message</strong>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger">
                            <a href="javascript:void(0)" class="close" onclick="DivHide()">&times;</a>
                            <strong>@ViewBag.msg.Message</strong>
                        </div>
                    }
                }
            </div>
        </div>*@
                </div>
            </div>
        </section>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <link href="~/app-assets/vendors/css/forms/selects/select2.min.css" rel="stylesheet" />
    <script src="~/app-assets/vendors/js/forms/select/select2.full.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('.select2').select2();

            // On Page Load
            if ($('#hdncompanyId').val() !== '0') {
                BindRole($('#hdncompanyId').val());
            }

            $('#MappingFor').change(function () {
                BindingData();
            });

            $('#FK_FormId, #FK_RoleId').change(function () {
                BindingData();
            });

            $('#FK_CompanyID').change(function () {
                BindForm($(this).val());
                BindRole($(this).val());
                $('#hdnroleId').val("0");
            });

            // Validation on submit
            $("button[type='submit']").on("click", function (e) {
                if (!$('#MappingFor').val()) {
                    alert("Please Select Mapping For.");
                    e.preventDefault(); return false;
                }

                $('#Mapping').val($('#MappingFor').val());

                if (!$('#FK_CompanyID').val()) {
                    alert("Please Select Company Name.");
                    e.preventDefault(); return false;
                }

                if ($('#FK_RoleId').val() === '0') {
                    alert("Please Select Role Name.");
                    e.preventDefault(); return false;
                }

                if (!$('#FK_FormId').val() || $('#FK_FormId').val() === '0') {
                    alert("Please Select Form Name.");
                    e.preventDefault(); return false;
                }

                if ($('#table > tbody > tr').length === 0) {
                    alert("No Data Is Available, Please Select Valid Data.");
                    e.preventDefault(); return false;
                }
            });

            // Handle "All" checkbox - select/deselect row rights
            $('#table').on('change', '.chbAll', function () {
                const isChecked = $(this).prop('checked');
                $(this).closest('tr')
                    .find('input[type="checkbox"]')
                    .not('.chbAll')
                    .prop('checked', isChecked);
            });

            // When any individual right checkbox changes, update "All" state
            $('#table').on('change', 'input[type="checkbox"]:not(.chbAll)', function () {
                const $row = $(this).closest('tr');
                const $rights = $row.find('input[type="checkbox"]').not('.chbAll');
                const allChecked = $rights.length === $rights.filter(':checked').length;
                $row.find('.chbAll').prop('checked', allChecked);
            });

        });

        function DivHide() {
            $('#msgDiv').hide();
        }

        function BindingData() {
            var roleId = parseInt($('#FK_RoleId').val()) || 0;
            var formId = parseInt($('#FK_FormId').val()) || 0;
            var mappingFor = $('#MappingFor').val();
            var companyId = $('#FK_CompanyID').val();

            if (roleId && formId && mappingFor && companyId) {
                $.ajax({
                    url: '@Url.Action("FormRole", "FormRoleMapping")',
                    type: 'GET',
                    data: {
                        roleId: roleId,
                        formId: formId,
                        MappingFor: mappingFor,
                        companyid: companyId
                    },
                    success: function (data) {
                        $('#TableDiv').html(data);
                    }
                });
            }
        }

        function BindRole(companyId) {
            $("#FK_RoleId").empty().append($('<option></option>').val("0").text("--Select--"));

            if (companyId === "0") return;

            $.getJSON('@Url.Action("getRole", "FormRoleMapping")', { companyId: companyId }, function (roles) {
                $.each(roles, function (i, role) {
                    $("#FK_RoleId").append($('<option></option>').val(role.ID).text(role.Value));
                });

                if ($('#hdncompanyId').val() !== '0') {
                    $('#FK_RoleId').val($('#hdnroleId').val());
                    $('#hdncompanyId').val(0);
                }
            });
        }

        function BindForm(companyId) {
            $("#FK_FormId").empty().append($('<option></option>').val("0").text("--Select--"));

            if (companyId === "0") return;

            $.getJSON('@Url.Action("getForms", "FormRoleMapping")', { companyId: companyId }, function (forms) {
                $.each(forms, function (i, form) {
                    $("#FK_FormId").append($('<option></option>').val(form.PK_FormId).text(form.FormName));
                });

                if ($('#hdncompanyId').val() !== '0') {
                    $('#FK_FormId').val($('#hdnformId').val());
                    $('#hdncompanyId').val(0);
                }

                $("#FK_FormId")[0].selectedIndex = 1;
                BindingData();
            });
        }
    </script>
}
