
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="main-content" class="container-fluid">
    <div class="page-heading mb-3">
        <div class="page-title">
            <div class="row">
                <div class="col-md-6">
                    <h3 class="fw-bold">Student Report</h3>
                </div>
            </div>
        </div>

        <section class="section">
            <div class="card shadow-sm">
                <div class="card-body">
                    <!-- Date Range Filter -->
                    <div class="row mb-4">
                        <div class="col-lg-6 col-md-8">
                            <label for="daterange" class="form-label fw-semibold">Date Range</label>
                            <div class="d-flex">
                                <input type="text" id="daterange" class="form-control me-2" placeholder="Select date range" style="min-width: 250px;" />
                                <button class="btn btn-primary" type="button" id="btnfilter">Apply</button>
                            </div>
                        </div>
                    </div>

                    <!-- Optional Search Filter (if you decide to enable later) -->
                    @*
                        <div class="row mb-4">
                            <div class="col-md-3">
                                <select class="form-control" id="SearchCreteria">
                                    <option value="">-- Select Search Type --</option>
                                    <option value="StudentName">Student Name</option>
                                    <option value="StudentCode">Student Code</option>
                                    <option value="ClassName">Class Name</option>
                                    <option value="ClassCode">Class Code</option>
                                    <option value="Stop">Stoppage</option>
                                </select>
                            </div>
                            <div class="col-md-5">
                                <input type="text" class="form-control" id="SearchValue" placeholder="Search Value" />
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-primary w-100" onclick="paging(1)">Search</button>
                            </div>
                        </div>
                    *@

                    <!-- Grid/Results Area -->
                    <div class="row">
                        <div class="col-md-12">
                            <div id="GridDiv">
                                @* @{ Html.RenderAction("GetStudentData"); } *@
                            </div>
                        </div>
                    </div>

                    <!-- Export Section (optional) -->
                    @*
                        <div class="row mt-4">
                            <div class="col text-end">
                                @using (Html.BeginForm("ExportToExcel", "StudentMaster"))
                                {
                                    <input type="image" title="Download Excel" src="~/App_Images/excel.jpg" class="me-2" style="width:32px;" />
                                }
                                <input type="image" title="Download PDF" src="~/App_Images/pdf.jpg" style="width:32px;" />
                            </div>
                        </div>
                    *@
                </div>
            </div>
        </section>
    </div>
</div>

@*@*******START Loader******@
<div class="modalBgLoader" style="display: none"></div>
<div class="modalLoaderCenter" style="display: none">
    <img alt="Loading..." src="~/App_Images/loader.gif" />
    <span>Loading...</span>
</div>
@*@*******END Loader******@

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <link href="~/assets/css/daterangepicker.css" rel="stylesheet" />
    <script src="~/assets/js/moment.min.js"></script>
    <script src="~/assets/js/daterangepicker.min.js"></script>

    <script type="text/javascript">

    $(document).ready(function (e) {
        //debugger

        $('#daterange').daterangepicker({
            opens: 'right',
            locale: {
                //format: 'YYYY-MM-DD'
                format: 'DD-MM-YYYY'
            },
            startDate: moment(),
            endDate: moment(),

            // ✅ Allow user to pick any range, across years or months
            showDropdowns: true,            // Allows year/month dropdown
            alwaysShowCalendars: true,     // Keeps calendars visible when ranges exist
            linkedCalendars: false,        // Prevents the 2 calendars from syncing month

            ranges: {
                'Today': [moment(), moment()],
                'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                'Last 30 Days': [moment().subtract(29, 'days'), moment()],
                'This Month': [moment().startOf('month'), moment().endOf('month')],
                'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')]
            }
        });

        $('#btnfilter').click(function (e) {
            paging(1);

        });

        paging(1);
        $('#SearchCreteria').change(function () {
            $('#SearchValue').val('');
            if ($('#SearchCreteria').val() == '') {
                paging(1);
            }

        });
    });
    function paging(currentpage) {
        if (currentpage == NaN || currentpage <= 0) {
            return false;
        }
        var dateRange = $('#daterange').val();
        var fromDate = "";
        var toDate = "";
        if (dateRange && dateRange.includes('-')) {
            var dates = dateRange.split(' - ');
            fromDate = dates[0].trim();
            toDate = dates[1].trim();
        }

        $.ajax({

            url:"@Url.Action("GetStudentData", "StudentReport")",
            type: 'GET',
            cache: false,
            data: {
                'CurrentPage': parseInt(currentpage), 'SearchBy': $("#SearchCreteria").val(), 'SearchValue': $("#SearchValue").val(), fromDate: fromDate,toDate: toDate },
            beforeSend: function () {
                $(".modalBgLoader, .modalLoaderCenter").show();
            },
            complete: function () {
                $(".modalBgLoader, .modalLoaderCenter").hide();
            },
            success: function (data) {
                $('#GridDiv').html(data);
                if ($('tbody > tr > td > div').html() == 'No Record Found. '){ $('#Export').hide(); }else{ $('#Export').show(); } //Disable "Export to Excel/PDF" Button if there No Record in table.
                $('.disabled').prop('disabled', true);
            },
        });
        return false;
    }

    </script>
}