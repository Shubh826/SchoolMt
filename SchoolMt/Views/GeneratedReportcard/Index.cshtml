@model MDL.StudentMasterMDL

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/assets/lib/lightbox/css/lightbox.css" rel="stylesheet" />
<div id="main-content">
    <div class="page-heading">
        <div class="page-title">
            <div class="row">
                <div class="col-12 col-md-6 order-md-1 order-last">
                    <h3>Student List</h3>
                </div>
            </div>
        </div>
        <section class="section">
            <div class="card shadow-sm">
                <div class="card-body" style="padding:20px;">

                    <!-- Filter Row -->
                    <div class="row" style="margin-bottom:15px; align-items:flex-end;">

                        <!-- Class -->
                        <div class="col-md-2" style="padding-right:12px;">
                            <label style="margin-bottom:5px;"><b>Class</b></label>
                            @Html.DropDownListFor(E => E.ClassName,
                                new SelectList((System.Collections.IEnumerable)ViewData["Classlist"], "Value", "Value"),
                                "--SELECT--",
                                new { @class = "form-control", style = "height:38px;" })
                        </div>

                        <!-- Section -->
                        <div class="col-md-2" style="padding-right:12px;">
                            <label style="margin-bottom:5px;"><b>Section</b></label>
                            @Html.DropDownListFor(E => E.ClassCode,
                                new SelectList((System.Collections.IEnumerable)ViewData["ClassCodelist"], "Value", "Value"),
                                "--SELECT--",
                                new { @class = "form-control", style = "height:38px;" })
                        </div>

                        <!-- Search By -->
                        <div class="col-md-2" style="padding-right:12px;">
                            <label style="margin-bottom:5px;"><b>Search By</b></label>
                            <select class="form-control" id="SearchCreteria" style="height:38px;">
                                <option value="">Select</option>
                                <option value="StudentName">Student Name</option>
                                <option value="FatherName">Father Name</option>
                            </select>
                        </div>

                        <!-- Search -->
                        <div class="col-md-2" style="padding-right:12px;">
                            <label style="margin-bottom:5px;"><b>Search</b></label>
                            <input type="text" class="form-control" id="SearchValue"
                                   placeholder="Enter value" style="height:38px;">
                        </div>

                        <!-- Buttons -->
                        <div class="col-md-2 d-flex gap-2">
                            <button type="button" class="btn btn-primary flex-fill" onclick="paging(1)">
                                Search
                            </button>
                           
                        </div>
                        <div class="col-md-2 d-flex gap-2">
                           
                            <button type="button" id="btnpdf" class="btn btn-success flex-fill">
                                Download PDF
                            </button>
                        </div>

                    </div>

                    <!-- Message -->
                    <div class="row" style="margin-top:10px;">
                        <div id="msgDiv" class="col-12">
                            @if (ViewBag.msg != null && (ViewBag.msg).Message_Id == 1)
                            {
                                <div class="alert alert-success">
                                    <a href="javascript:void(0)" class="close" data-dismiss="alert">&times;</a>
                                    <strong>@ViewBag.msg.Message</strong>
                                </div>
                            }
                            else if (ViewBag.msg != null)
                            {
                                <div class="alert alert-danger">
                                    <a href="javascript:void(0)" class="close" data-dismiss="alert">&times;</a>
                                    <strong>@ViewBag.msg.Message</strong>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Grid -->
                    <div class="row" style="margin-top:15px;">
                        <div class="col-md-12">
                            <div id="GridDiv"></div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <script>
            setTimeout(function () {
                document.getElementById("msgDiv").style.display = "none";
            }, 5000);
        </script>
    </div>
    @*<footer>
            <div class="footer clearfix mb-0 text-muted">
                <div class="float-start">
                    <p>2022 &copy; SchoolMt</p>
                </div>
            </div>
        </footer>*@
</div>


<div id="myModal1" class="modal fade">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <a class="close" id="lnkIndexUpdate" href="javascript:void(0)" onclick="$('#myModal1').modal('hide');">
                    <img src="~/images/close.png" />
                </a>
                <h4 class="modal-title">Attendant Image</h4>
            </div>
            <div class="img">
                <img id="img" src="" style="margin-left:240px" />
            </div>
        </div>
    </div>
</div>
@*@*******START Loader******@
<div class="modalBgLoader" style="display: none"></div>
<div class="modalLoaderCenter" style="display: none">
    <img alt="Loading..." src="~/App_Images/loader.gif" />
    <span>Loading...</span>
</div>
@*@*******END Loader******@
@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/assets/lib/lightbox/js/lightbox.js"></script>

    <link href="~/css/nanoscroller.css" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="~/assets/lib/stroke-7/style.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/lib/jquery.nanoscroller/css/nanoscroller.css" />
    <link href="~/assets/lib/lightbox/css/lightbox.css" rel="stylesheet" />

    <script src="~/js/jspdf.debug.js"></script>
    <script src="~/js/jspdf.plugin.autotable.js"></script>
    <script src="~/js/ExcelPDF.js"></script>
    @*<script src="~/Scripts/jquery.table2excel.js"></script>*@
    <script src="~/js/jquery.table2excel.js"></script>

    <script type="text/javascript">

    $(document).ready(function (e) {
        //debugger
        $('#Export').hide();
      
        $('#btnpdf').on('click', function (e) {
            downloadPdf(e);
        });

        paging(1);
        $('#SearchCreteria').change(function () {
            $('#SearchValue').val('');
            if ($('#SearchCreteria').val() == '') {
                paging(1);
            }

        });
    
    });

    function paging(currentpage) {
        if (currentpage == NaN || currentpage <= 0) {
            return false;
        }
        $.ajax({

            url:"@Url.Action("GetStudentData", "GeneratedReportcard")",
            type: 'GET',
            cache: false,
            data: { 'CurrentPage': parseInt(currentpage), 'SearchBy': $("#SearchCreteria").val(), 'SearchValue': $("#SearchValue").val(), 'ClassName': $("#ClassName").val(), 'Section': $("#ClassCode").val() },
            beforeSend: function () {
                $(".modalBgLoader, .modalLoaderCenter").show();
            },
            complete: function () {
                $(".modalBgLoader, .modalLoaderCenter").hide();
            },
            success: function (data) {
                $('#GridDiv').html(data);
                if ($('tbody > tr > td > div').html() == 'No Record Found. '){ $('#Export').hide(); }else{ $('#Export').show(); } //Disable "Export to Excel/PDF" Button if there No Record in table.
                $('.disabled').prop('disabled', true);
            },
        });
        return false;
    }
    function showimage(ImageUrl) {
        $('#img').attr('src', ImageUrl);
        $('#img').attr('height', 100);
        $('#img').attr('width', 100);
        $('#myModal1').modal('show');
        }

        function downloadPdf(e)
        {
            debugger;
            // ✅ Call controller (TempData already has data)
          //  window.open('/GeneratedReportcard/GenerateAllStudentsHtml', '_blank');
            GeneratedReportcardPDF(e);

        }



    function GeneratedReportcardPDF(e) {
    e.preventDefault(); // prevent full form submission
    $.ajax({
        url: "@Url.Action("GetReportcardHtmlForPDF", "GeneratedReportcard")",
        cache: false,
        contentType: "application/json; charset=utf-8",
        data: {},
        beforeSend: function () {
            $(".modalBgLoader, .modalLoaderCenter").show();
        },
        complete: function () {
            $(".modalBgLoader, .modalLoaderCenter").hide();
        },
        success: function (data) {
            var htmlContent = data;

            var printFrame = document.createElement('iframe');
            printFrame.style.display = 'none';

            document.body.appendChild(printFrame);
            var printDocument = printFrame.contentDocument;

            printDocument.write(htmlContent);
            printDocument.close();

            printFrame.onload = function () {
                printFrame.contentWindow.focus();
                printFrame.contentWindow.print();

               
            };
        },
        error: function (xhr) {
            alert("Error generating receipt.");
        },
        failure: function (res) {
            alert("Failed to generate receipt.");
        },
    });
}
    </script>
}