    @Html.HiddenFor(model => model.HdnPaymentDate)
    @Html.HiddenFor(model => model.ClassName)
    @Html.HiddenFor(model => model.FK_StudentId)
    <div class="container mt-4">
        <h3 class="text-center mb-3">Add/Edit Book or Notebook Bill</h3>
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-8 offset-md-2">
                        <div class="row">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                            <!-- Class Name -->
                            <div class="col-md-3">
                                <label class="bold">Class Name<span class="text-danger">*</span></label>
                            </div>
                            <div class="col-md-7 form-group">
                                @Html.DropDownListFor(E => E.FK_ClassId, new SelectList((System.Collections.IEnumerable)ViewData["ClassList"], "ID", "Value"), "--Select--", new { @class = "form-control select2" })
                                @*@Html.ValidationMessageFor(E => E.ClassName, "", new { @class = "redText", @style = "color:red" })*@
                            </div>



                            <!-- Student Name -->
                            <div class="col-md-3">
                                <label class="bold">Student Name<span class="text-danger">*</span></label>
                            </div>
                            <div class="col-md-7 form-group">
                                @Html.TextBoxFor(model => model.StudentName, new { @class = "form-control", @placeholder = "Enter Student Name", autocomplete = "off", @id = "StudentName" })
                                @*@Html.ValidationMessageFor(model => model.StudentName, "", new { @class = "text-danger" })*@
                            </div>



