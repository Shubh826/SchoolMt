    function SetBookID() {
        debugger
        let selectedBooks = [];

        $(".book-checkbox:checked").each(function () {
            let row = $(this).closest("tr"); // Get the closest table row

            let bookId = $(this).data("id");  // Get notebook ID from data attribute
            let BookName = row.find(".book-Name").text().trim();
            let price = $(this).data("price"); // Get price from data attribute

            selectedBooks.push({
                id: bookId,
                BookName: BookName,
                price: parseFloat(price)
            });
        });

        // Store as a proper JSON string
        $("#SelectedBookIds").val(JSON.stringify(selectedBooks));
    }
    function SetNoteBookID() {
        debugger;
        let selectedNotebooks = [];

        $(".notebook-checkbox:checked").each(function () {
            let row = $(this).closest("tr"); // Get the closest table row

            let notebookId = $(this).data("id");  // Get notebook ID from data attribute
            let notebookPage = row.find(".notebook-page").text().trim(); // Get notebook page count
            let price = $(this).data("price"); // Get price from data attribute
            let quantity = row.find(".quantity-input").val() || 1; // Get quantity from input field

            selectedNotebooks.push({
                id: notebookId,
                NotebookPage: notebookPage,
                price: parseFloat(price),
                quantity: parseInt(quantity)
            });
        });

        // Store as a proper JSON string
        $("#SelectedNotebookIds").val(JSON.stringify(selectedNotebooks));
    }

    // Function to calculate subtotal and grand total
    function calculateTotal() {
        let subtotal = 0;

        // Loop through checked books
        $(".book-checkbox:checked").each(function () {
            subtotal += parseFloat($(this).data("price")) || 0;
        });

        // Loop through checked notebooks
        $(".notebook-checkbox:checked").each(function () {
            subtotal += parseFloat($(this).data("price")) * parseInt($(this).closest("tr").find(".quantity-input").val()) || 0;
        });

        // Set subtotal value
        $("#subtotal").val(subtotal.toFixed(2));

        // Calculate GST and grand total
        let gst = parseFloat($("#gst").val()) || 0;
        let grandTotal = subtotal - $("#Discount").val();
        $("#grandTotal").val(grandTotal.toFixed(2));
    }
    function fetchBooksonchange() {
    $.ajax({
        url: '@Url.Action("GetBooksOrNoteBooks", "BookOrNoteBookBill")',
        type: "GET",
        dataType: "json",
        data: { Type: 'Book', ClassName: $('#FK_ClassId option:selected').text() },
        success: function (data) {
            let bookTable = $("#bookList tbody");
            bookTable.empty(); // Clear old data

            if (data.length > 0) {
                $.each(data, function (index, book) {
                    let row = `<tr>
                        <td><input type="checkbox" class="form-check-input book-checkbox" data-price="${book.Price}" data-id="${book.PK_BookId}"></td>
                        <td class="book-Name">${book.BookName}</td>
                        <td>${book.Price}</td>
                    </tr>`;
                    bookTable.append(row);
                });

                // Re-bind event handlers after table is populated
                bindCheckboxEvents();
            } else {
                bookTable.append("<tr><td colspan='3' class='text-center'>No Books Available</td></tr>");
            }
        },
        error: function (xhr, status, error) {
            console.error("Error fetching book list: ", error);
        }
    });
}

function bindCheckboxEvents() {
    // Select All handler
    $('#selectAllBooks').off().on('change', function () {
        let isChecked = $(this).is(':checked');
        $('.book-checkbox').prop('checked', isChecked);
    });

    // Individual book checkbox change handler
    $('#bookList').off('change', '.book-checkbox').on('change', '.book-checkbox', function () {
        let allChecked = $('.book-checkbox').length === $('.book-checkbox:checked').length;
        $('#selectAllBooks').prop('checked', allChecked);
    });
}
function fetchBooks() {
        $.ajax({
            url: '@Url.Action("GetBooksOrNoteBooks", "BookOrNoteBookBill")',
            type: "GET",
            dataType: "json",
            data: { Type: 'Book', ClassName: $('#FK_ClassId option:selected').text() },
            success: function (data) {
                let bookTable = $("#bookList tbody");
                bookTable.empty(); // Clear old data

                if (data.length > 0) {
                    $.each(data, function (index, book) {
                        let row = `<tr>
                            <td><input type="checkbox" class="form-check-input book-checkbox" data-price="${book.Price}" data-id="${book.PK_BookId}"></td>
                            <td class="book-Name">${book.BookName}</td>
                            <td>${book.Price}</td>
                        </tr>`;
                        bookTable.append(row);
                    });
                } else {
                    bookTable.append("<tr><td colspan='3' class='text-center'>No Books Available</td></tr>");
                }
            },
            error: function (xhr, status, error) {
                console.error("Error fetching book list: ", error);
            }
        });
    }

// Function to fetch and bind notebook list
    function fetchNotebooks() {
        debugger
        $.ajax({
            url: '@Url.Action("GetBooksOrNoteBooks", "BookOrNoteBookBill")',
            type: "GET",
            dataType: "json",
            data: { Type: 'NoteBook', ClassName: $('#FK_ClassId option:selected').text() },
            success: function (data) {
                debugger
                let notebookTable = $("#notebookList tbody");
                notebookTable.empty(); // Clear old data

                if (data.length > 0) {
                    $.each(data, function (index, Notebook) {
                    let row = `<tr>
                        <td><input type="checkbox" class="form-check-input notebook-checkbox" data-price="${Notebook.Price}" data-id="${Notebook.PK_BookId}"></td>
                        <td class="notebook-page">${Notebook.NotebookPage}</td>
                        <td>${Notebook.Price}</td>
                        <td><input type="number" class="form-control quantity-input" value="1" min="1"></td>
                    </tr>`;
                        notebookTable.append(row);
                    });

                } else {
                    notebookTable.append("<tr><td colspan='3' class='text-center'>No Notebooks Available</td></tr>");
                }
            },
            error: function (xhr, status, error) {
                console.error("Error fetching notebook list: ", error);
            }
        });
    }

function ReceiptPDF(e) {
    e.preventDefault(); // prevent full form submission
    $.ajax({
        url: "@Url.Action("GenerateBookOrNoteBookPaymentReceiptAfterPayment", "BookOrNoteBookBill")",
        cache: false,
        contentType: "application/json; charset=utf-8",
        data: {},
        success: function (data) {
            var htmlContent = data;

            var printFrame = document.createElement('iframe');
            printFrame.style.display = 'none';

            document.body.appendChild(printFrame);
            var printDocument = printFrame.contentDocument;

            printDocument.write(htmlContent);
            printDocument.close();

            printFrame.onload = function () {
                printFrame.contentWindow.focus();
                printFrame.contentWindow.print();

                // ✅ Fallback: wait for print to complete, then redirect
               // setTimeout(function () {
                    window.location.href = '@Url.Action("Index", "BookOrNoteBookBill")';
               // }, 1000); // 1 second delay — you can increase if needed
            };
        },
        error: function (xhr) {
            alert("Error generating receipt.");
        },
        failure: function (res) {
            alert("Failed to generate receipt.");
        },
    });
}



    </script>

