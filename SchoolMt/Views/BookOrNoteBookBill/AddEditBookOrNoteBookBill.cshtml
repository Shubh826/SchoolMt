@using Newtonsoft.Json
@model MDL.BookOrNoteBookBillMDL

@{
    ViewBag.Title = "Book or Notebook Bill";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("AddEditBookOrNoteBookBill", "BookOrNoteBookBill", FormMethod.Post, new { enctype = "multipart/form-data", id = "PostBookOrNoteBookBillForm" }))
{
    @Html.HiddenFor(model => model.PK_BorNBillID)
    @Html.HiddenFor(model => model.SelectedBookIds)
    @Html.HiddenFor(model => model.SelectedNotebookIds)
    @Html.HiddenFor(model => model.HdnPaymentDate)
    @Html.HiddenFor(model => model.ClassName)
    @Html.HiddenFor(model => model.FK_StudentId)

    <div class="page-heading mb-0">
        <div class="page-title">
            <div class="row">
                <div class="col-12 col-md-6 order-md-1 order-last">
                    <h3>Add Edit Book or Notebook Bill</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-content">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-12">
                        <div class="panel panel-default">
                            <div class="panel-body">
                                <div class="form-horizontal">
                                    <div class="row">
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                        <!-- Class Name -->
                                        <div class="col-md-3">
                                            <label class="bold">Class Name <span class="text-danger">*</span></label>
                                        </div>
                                        <div class="col-md-7 form-group">
                                            @Html.DropDownListFor(E => E.FK_ClassId,
                                                new SelectList((System.Collections.IEnumerable)ViewData["ClassList"], "ID", "Value"),
                                                "-- Select --",
                                                new { @class = "form-control select2" })
                                        </div>

                                        <!-- Student Name -->
                                        <div class="col-md-3">
                                            <label class="bold">Student Name <span class="text-danger">*</span></label>
                                        </div>
                                        <div class="col-md-7 form-group">
                                            @Html.TextBoxFor(model => model.StudentName,
                                                new { @class = "form-control", @placeholder = "Enter Student Name", autocomplete = "off", @id = "StudentName" })
                                        </div>

                                        <!-- Type Selection -->
                                        <div class="col-md-3">
                                            <label class="bold">Type:</label>
                                        </div>
                                        <div class="col-md-7 form-group">
                                            <div class="form-check form-check-inline">
                                                @Html.CheckBoxFor(model => model.IsBook, new { @class = "form-check-input", @id = "bookCheck" })
                                                <label class="form-check-label" for="bookCheck">Book</label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                @Html.CheckBoxFor(model => model.IsNotebook, new { @class = "form-check-input", @id = "notebookCheck" })
                                                <label class="form-check-label" for="notebookCheck">Notebook</label>
                                            </div>
                                        </div>

                                        <!-- Book List -->
                                        <div class="col-md-12">
                                            <div id="bookListSection" style="display: none;">
                                                <h5 class="mb-3">Book List</h5>
                                                <div class="table-responsive">
                                                    <table class="table table-bordered table-hover align-middle" id="bookList">
                                                        <thead class="table-dark">
                                                            <tr>
                                                                <th class="text-center" style="width: 60px;">
                                                                    <div class="form-check m-0 d-flex align-items-center justify-content-center">
                                                                        <input type="checkbox" id="selectAllBooks" class="form-check-input me-2" />
                                                                        <label class="form-check-label mb-0" for="selectAllBooks">Select</label>
                                                                    </div>
                                                                </th>
                                                                <th>Book Name</th>
                                                                <th class="text-end" style="width: 120px;">Price</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <!-- Books will be appended dynamically -->
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>


                                        <!-- Notebook List -->
                                        <div class="col-md-12">
                                            <div id="notebookListSection" style="display: none;">
                                                <h5 class="mb-3">Notebook List</h5>
                                                <div class="table-responsive">
                                                    <table class="table table-bordered table-hover align-middle" id="notebookList">
                                                        <thead class="table-dark">
                                                            <tr>
                                                                <th class="text-center" style="width: 60px;">
                                                                    <div class="form-check m-0 d-flex align-items-center justify-content-center">
                                                                        <input type="checkbox" id="selectAllNotebooks" class="form-check-input me-2" />
                                                                        <label class="form-check-label mb-0" for="selectAllNotebooks">Select</label>
                                                                    </div>
                                                                </th>
                                                                <th>Notebook Page</th>
                                                                <th class="text-end" style="width: 120px;">Price</th>
                                                                <th class="text-center" style="width: 100px;">Quantity</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <!-- Notebooks will be appended dynamically -->
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Other -->
                                        <div class="col-md-3">
                                            <label class="bold">Other</label>
                                        </div>
                                        <div class="col-md-7 form-group">
                                            @Html.TextBoxFor(E => E.Other, new { @class = "form-control", maxlength = "15", @placeholder = "Other" })
                                        </div>

                                        <!-- Discount -->
                                        <div class="col-md-3">
                                            <label class="bold">Discount <span class="text-danger">*</span></label>
                                        </div>
                                        <div class="col-md-7 form-group">
                                            @Html.TextBoxFor(model => model.Discount, new { @class = "form-control", @type = "number", @id = "Discount" })
                                        </div>

                                        <!-- Grand Total -->
                                        <div class="col-md-3">
                                            <label class="bold">Grand Total <span class="text-danger">*</span></label>
                                        </div>
                                        <div class="col-md-7 form-group">
                                            @Html.TextBoxFor(model => model.GrandTotal, new { @class = "form-control", @readonly = "readonly", @id = "grandTotal" })
                                        </div>

                                        <!-- Payment Date -->
                                        <div class="col-md-3">
                                            <label class="bold">Payment Date <span class="text-danger">*</span></label>
                                        </div>
                                        <div class="col-md-7 form-group">
                                            @*@Html.TextBoxFor(model => model.PaymentDate, new
            {
                @class = "form-control",
                @type = "date",
                @id = "PaymentDate",
                @Value = Model.PaymentDate != null
              ? Model.PaymentDate
              : DateTime.Now.ToString("dd-MM-yyyy")
            })*@
                                            @Html.TextBoxFor(E => E.PaymentDate, new { @class = "form-control", maxlength = "200", @placeholder = "PaymentDate" })

                                        </div>

                                        <!-- Cash -->
                                        <div class="col-md-3">
                                            <label class="bold">Cash <span class="text-danger">*</span></label>
                                        </div>
                                        <div class="col-md-7 form-group">
                                            @Html.TextBoxFor(E => E.Cash, new { @class = "form-control", maxlength = "15", @placeholder = "Cash" })
                                            @Html.ValidationMessageFor(E => E.Cash)
                                        </div>

                                        <!-- Online -->
                                        <div class="col-md-3">
                                            <label class="bold">Online <span class="text-danger">*</span></label>
                                        </div>
                                        <div class="col-md-7 form-group">
                                            @Html.TextBoxFor(E => E.Online, new { @class = "form-control", maxlength = "50", @placeholder = "Online" })
                                            @Html.ValidationMessageFor(E => E.Online)
                                        </div>

                                        <!-- Due Amount -->
                                        <div class="col-md-3">
                                            <label class="bold">Due Amount</label>
                                        </div>
                                        <div class="col-md-7 form-group">
                                            @Html.TextBoxFor(model => model.DueAmount, new { @class = "form-control", type = "number", id = "DueAmount" })
                                        </div>

                                        <!-- Hidden Fields -->
                                        <input type="hidden" id="tempMessage" value='@JsonConvert.SerializeObject(TempData["Message"])' />
                                        <input type="hidden" id="StudentID" value='@Model.FK_StudentId' />
                                        <input type="hidden" id="ClassNameId" value='@Model.ClassName' />

                                        <!-- Buttons -->
                                        <div class="col-sm-9 d-flex justify-content-end">
                                            <button type="submit" class="btn btn-primary box-shadow-1 btn-min-width mr-1 mb-1">Submit</button>
                                            <a href='@Url.Action("Index")' class="btn btn-dark box-shadow-1 btn-min-width mr-1 mb-1">Cancel</a>
                                        </div>

                                    </div> <!-- row -->
                                </div> <!-- form-horizontal -->
                            </div> <!-- panel-body -->
                        </div> <!-- panel -->
                    </div>
                </div>
            </div>
        </div>
    </div>
}



@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <link href="~/assets/css/jquery-ui.css" rel="stylesheet" />
    <link href="~/assets/css/daterangepicker.css" rel="stylesheet" />
    <link href="~/app-assets/vendors/css/forms/selects/select2.min.css" rel="stylesheet" />
    <script src="~/app-assets/vendors/js/forms/select/select2.full.min.js"></script>

    <script src="~/assets/js/moment.min.js"></script>
    <script src="~/assets/js/daterangepicker.min.js"></script>
    <script src="~/assets/js/jquery-ui.js"></script>
    <script>
$(document).ready(function (e) {

    $('#PaymentDate').daterangepicker({
        singleDatePicker: true,
        showDropdowns: true,
        autoUpdateInput: true,
        opens: 'right',
        locale: {
            //  format: 'YYYY-MM-DD'
            format: 'DD-MM-YYYY'
        },
        maxDate: moment() // disable future dates
    });

    var IsBookCheck = false;
    var IsNoteBookCheck = false;

    if ($('#bookCheck').is(":checked"))
    {
        IsBookCheck = true;
    }

    if ($('#notebookCheck').is(":checked"))
    {
        IsNoteBookCheck = true;
    }


    if ($('#PK_BorNBillID').val() > 0) {
     //   alert($('#PK_BorNBillID').val());
        SetBookOnEdit(IsBookCheck);
        SetNoteBookOnEdit(IsNoteBookCheck);
    }

    // ✅ Form Submit
    $('#PostBookOrNoteBookBillForm').on('submit', function (e) {
        e.preventDefault();

        // Class Validation
        let className = $("#FK_ClassId").val();
        if (className === "" || className === "--Select--") {
            alert("Please Select Class.");
            return false;
        }
        $('#ClassNameId').val($('#FK_ClassId option:selected').text());
        $('#ClassName').val($('#FK_ClassId option:selected').text());

        // Student Validation
        let studentName = $("#StudentName").val().trim();
        if (studentName === "") {
            alert("Please Enter Student Name.");
            return false;
        }

        // Book/Notebook Selection Validation
        let isBookChecked = $("#bookCheck").is(":checked");
        let isNotebookChecked = $("#notebookCheck").is(":checked");

        if (!isBookChecked && !isNotebookChecked) {
            alert("At least one option (Book or Notebook) must be selected.");
            return false;
        }

        // Book list validation
        if ($("#bookListSection").is(":visible") && $(".book-checkbox:checked").length === 0) {
            alert("Please select at least one Book from the list.");
            return false;
        }

        // Notebook list validation
        if ($("#notebookListSection").is(":visible") && $(".notebook-checkbox:checked").length === 0) {
            alert("Please select at least one Notebook from the list.");
            return false;
        }

        // Grand Total Validation
        let grandTotal = parseFloat($("#grandTotal").val()) || 0;
        if (grandTotal <= 0) {
            alert("Grand Total must be greater than 0.");
            return false;
        }

        // Payment Date Format Conversion
        var inputDate = $('#PaymentDate').val();
        if (inputDate) {
            var parts = inputDate.split("-");
            var formattedDate = parts[2] + "-" + parts[1] + "-" + parts[0]; // YYYY-MM-DD
            $('#HdnPaymentDate').val(formattedDate);
        }

        // ✅ AJAX submit
        var form = $('#PostBookOrNoteBookBillForm')[0];
        var formData = new FormData(form);

        $.ajax({
            url: '@Url.Action("AddEditBookOrNoteBookBill", "BookOrNoteBookBill")',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (response) {
                if (response.Message_Id === 1) {
                    ReceiptPDF(e);
                } else {
                    alert("Something went wrong.");
                }
            },
            error: function () {
                alert('Error while submitting the form.');
            }
        });
    });

    // ✅ Autocomplete for Student Name
    $("#StudentName").autocomplete({
        source: function (request, response) {
            $.ajax({
                 url: '@Url.Action("GetStudentNames", "BookOrNoteBookBill")',
                type: "GET",
                dataType: "json",
                data: { term: request.term },
                success: function (data) {
                    response($.map(data, function (item) {
                        return { label: item.Value, value: item.Value, id: item.ID };
                    }));
                },
                error: function (xhr, status, error) {
                    console.error("Error in autocomplete: ", error);
                }
            });
        },
        minLength: 1,
        select: function (event, ui) {
            $("#StudentName").val(ui.item.value);
            $("#FK_StudentId").val(ui.item.id);
            return false;
        }
    });

    $('#FK_ClassId').change(function () {
        $('#StudentName').val('');
        $.ajax({
            url: '@Url.Action("GetStudentNameByClassName", "BookOrNoteBookBill")',
            type: "GET",
            data: { "FK_ClassId": $('#FK_ClassId').val() }
        });
    });

    // ✅ Book Checkbox
    $("#bookCheck").change(function () {
        if ($(this).is(":checked")) {
            if ($('#FK_ClassId').val() !== '' && $('#StudentName').val()) {
                fetchBooksonchange();
                setTimeout(function () {
                    $("#bookListSection").show();
                    bindCheckboxEvents(); // ensure event bindings
                    calculateTotal();
                    SetBookID();
                    SetNoteBookID();
                }, 300);
            } else {
                alert('Class Name and Student Name are Mandatory!');
                $(this).prop('checked', false);
            }
        } else {
            $("#bookListSection").hide();
            $("#bookList tbody").empty();
            $('#selectAllBooks').prop('checked', false);
            calculateTotal();
        }
    });

    // ✅ Notebook Checkbox
    $("#notebookCheck").change(function () {
        if ($(this).is(":checked")) {
            if ($('#FK_ClassId').val() != '') {
                $("#notebookListSection").show();
                fetchNotebooks();
            } else {
                alert('Please Select Class Name!');
            }
        } else {
            $("#notebookListSection").hide();
            $("#notebookList tbody").empty();
            $('#selectAllNotebooks').prop('checked', false);
        }
        calculateTotal();
    });

    // ✅ Dynamic Events
    $(document).on("input", "#Discount, #Other", function () {
        calculateTotal();
    });

    $(document).on("change", ".quantity-input", function () {
        calculateTotal();
        SetNoteBookID();
    });
});

      
// ✅ Set Book IDs
function SetBookID() {
    let selectedBooks = [];
    $(".book-checkbox:checked").each(function () {
        let row = $(this).closest("tr");
        selectedBooks.push({
            id: $(this).data("id"),
            BookName: row.find(".book-name").text().trim(),
            price: parseFloat($(this).data("price"))
        });
    });
    $("#SelectedBookIds").val(JSON.stringify(selectedBooks));
}

// ✅ Set Notebook IDs
function SetNoteBookID() {
    let selectedNotebooks = [];
    $(".notebook-checkbox:checked").each(function () {
        let row = $(this).closest("tr");
        selectedNotebooks.push({
            id: $(this).data("id"),
            NotebookPage: row.find(".notebook-page").text().trim(),
            price: parseFloat($(this).data("price")),
            quantity: parseInt(row.find(".quantity-input").val() || 1)
        });
    });
    $("#SelectedNotebookIds").val(JSON.stringify(selectedNotebooks));
}

// ✅ Calculate Total
function calculateTotal() {
    let subtotal = 0;
    let other = parseFloat($("#Other").val()) || 0;
    let discount = parseFloat($("#Discount").val()) || 0;

    $(".book-checkbox:checked").each(function () {
        subtotal += parseFloat($(this).data("price")) || 0;
    });

    $(".notebook-checkbox:checked").each(function () {
        let row = $(this).closest("tr");
        subtotal += (parseFloat($(this).data("price")) || 0) * (parseInt(row.find(".quantity-input").val()) || 1);
    });

    subtotal += other;
    $("#grandTotal").val((subtotal - discount).toFixed(2));
}

// ✅ Fetch Books
function fetchBooksonchange() {
    $.ajax({
        url: '@Url.Action("GetBooksOrNoteBooks", "BookOrNoteBookBill")',
        type: "GET",
        dataType: "json",
        data: { Type: 'Book', ClassName: $('#FK_ClassId option:selected').text(), BillId: $('#PK_BorNBillID').val()},
        success: function (data) {
            let bookTable = $("#bookList tbody");
            bookTable.empty();

            if (data.length > 0) {
                $.each(data, function (index, book) {
                    let row = `
<tr>
    <td class="text-center">
        <div class="form-check d-flex align-items-center justify-content-center m-0">
            <input type="checkbox" class="form-check-input book-checkbox"
                   data-price="${book.Price}"
                   data-id="${book.PK_BookId}"
                   ${book.Ischeck ? 'checked' : ''}>
        </div>
    </td>
    <td class="book-name">${book.BookName}</td>
    <td class="text-end">${book.Price}</td>
</tr>`;
                    bookTable.append(row);
                });
                selectAllNotebookorbook();
                bindCheckboxEvents(); // ✅ Bind Book and Notebook events
            } else {
                bookTable.append("<tr><td colspan='3' class='text-center text-muted'>No Books Available</td></tr>");
            }
        }
    });
}

// ✅ Fetch Notebooks
function fetchNotebooks() {
    $.ajax({
        url: '@Url.Action("GetBooksOrNoteBooks", "BookOrNoteBookBill")',
        type: "GET",
        dataType: "json",
        data: { Type: 'NoteBook', ClassName: $('#FK_ClassId option:selected').text(), BillId: $('#PK_BorNBillID').val() },
        success: function (data) {
            let notebookTable = $("#notebookList tbody");
            notebookTable.empty();

            if (data.length > 0) {
                $.each(data, function (index, Notebook) {
                    let row = `
<tr>
    <td class="text-center">
        <div class="form-check d-flex align-items-center justify-content-center m-0">
            <input type="checkbox" class="form-check-input notebook-checkbox"
                   data-price="${Notebook.Price}"
                   data-id="${Notebook.PK_BookId}"
                   ${Notebook.Ischeck ? 'checked' : ''}>
        </div>
    </td>
    <td class="notebook-page">${Notebook.NotebookPage}</td>
    <td class="text-end">${Notebook.Price}</td>
    <td class="text-center">
        <input type="number" class="form-control text-center quantity-input"
               value="1" min="1" style="max-width: 80px;">
    </td>
</tr>`;
                    notebookTable.append(row);
                });
                selectAllNotebookorbook();
                bindCheckboxEvents(); // ✅ Bind Book and Notebook events
            } else {
                notebookTable.append("<tr><td colspan='4' class='text-center text-muted'>No Notebooks Available</td></tr>");
            }
        }
    });
        }
        function selectAllNotebookorbook() {
            $('#selectAllBooks').prop('checked', $('.book-checkbox').length === $('.book-checkbox:checked').length);
            $('#selectAllNotebooks').prop('checked', $('.notebook-checkbox').length === $('.notebook-checkbox:checked').length);
            SetBookID();
            SetNoteBookID(); 


        }

        // ✅ Checkbox Events (Books + Notebooks)
        function bindCheckboxEvents() {
            // --- Books ---
            $(document).off('change', '#selectAllBooks').on('change', '#selectAllBooks', function () {
                $('.book-checkbox').prop('checked', $(this).is(':checked'));
                calculateTotal();
                SetBookID();
            });

            $(document).off('change', '.book-checkbox').on('change', '.book-checkbox', function () {
                $('#selectAllBooks').prop('checked', $('.book-checkbox').length === $('.book-checkbox:checked').length);
                calculateTotal();
                SetBookID();
            });

            // --- Notebooks ---
            $(document).off('change', '#selectAllNotebooks').on('change', '#selectAllNotebooks', function () {
                $('.notebook-checkbox').prop('checked', $(this).is(':checked'));
                calculateTotal();
                SetNoteBookID();
            });

            $(document).off('change', '.notebook-checkbox').on('change', '.notebook-checkbox', function () {
                $('#selectAllNotebooks').prop('checked', $('.notebook-checkbox').length === $('.notebook-checkbox:checked').length);
                calculateTotal();
                SetNoteBookID();
            });
        }



// ✅ Receipt PDF
function ReceiptPDF(e) {
    e.preventDefault(); // prevent full form submission
    $.ajax({
        url: "@Url.Action("GenerateBookOrNoteBookPaymentReceiptAfterPayment", "BookOrNoteBookBill")",
        cache: false,
        contentType: "application/json; charset=utf-8",
        data: {},
        success: function (data) {
            var htmlContent = data;

            var printFrame = document.createElement('iframe');
            printFrame.style.display = 'none';

            document.body.appendChild(printFrame);
            var printDocument = printFrame.contentDocument;

            printDocument.write(htmlContent);
            printDocument.close();

            printFrame.onload = function () {
                printFrame.contentWindow.focus();
                printFrame.contentWindow.print();

                // ✅ Fallback: wait for print to complete, then redirect
               // setTimeout(function () {
                    window.location.href = '@Url.Action("Index", "BookOrNoteBookBill")';
               // }, 1000); // 1 second delay — you can increase if needed
            };
        },
        error: function (xhr) {
            alert("Error generating receipt.");
        },
        failure: function (res) {
            alert("Failed to generate receipt.");
        },
    });
}

// ✅ Edit Mode
function SetBookOnEdit(IsBookCheck) {
    if (IsBookCheck) {
        if ($('#FK_ClassId').val() !== '' && $('#StudentName').val()) {
            fetchBooksonchange();
            setTimeout(function () {
                $("#bookListSection").show();
                bindCheckboxEvents();
                calculateTotal();
                SetBookID();
                SetNoteBookID();
            }, 300);
        } else {
            alert('Class Name and Student Name are Mandatory!');
            $("#bookCheck").prop('checked', false);
        }
    } else {
        $("#bookListSection").hide();
        $("#bookList tbody").empty();
        $('#selectAllBooks').prop('checked', false);
        calculateTotal();
    }
}

function SetNoteBookOnEdit(IsNoteBookCheck) {
    if (IsNoteBookCheck) {
        if ($('#FK_ClassId').val() != '') {
            $("#notebookListSection").show();
            fetchNotebooks();
        } else {
            alert('Please Select Class Name!');
        }
    } else {
        $("#notebookListSection").hide();
        $("#notebookList tbody").empty();
        $('#selectAllNotebooks').prop('checked', false);
    }
    calculateTotal();
}
    </script>

}
