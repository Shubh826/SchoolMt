@model MDL.BookOrNoteBookBillMDL

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/css/nanoscroller.css" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/assets/lib/stroke-7/style.css" />
<link rel="stylesheet" type="text/css" href="~/assets/lib/jquery.nanoscroller/css/nanoscroller.css" />

<div id="main-content">
    <div class="page-heading">
        <div class="page-title">
            <div class="row">
                <div class="col-12 col-md-6 order-md-1 order-last">
                    <h3>Bill Or NoteBook Bill</h3>
                </div>
                <div class="col-12 col-md-6 order-md-2 order-first">
                    <a class="btn btn-purple" href="@Url.Action("AddEditBookOrNoteBookBill")" style="float: right;"><i class="fa fa-plus"></i> Add New Bill</a>
                </div>
            </div>
        </div>
        <section class="section">
            <div class="card">
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-lg-3 col-md-6">
                            <div class="form-group">
                                <label for="SearchCreteria" class="form-label">Select Criteria</label>
                                <select class="form-control" id="SearchCreteria">
                                    <option selected="selected" value="">Select</option>
                                    <option value="StudentName">Student Name</option>
                                    <option value="ClassName">Class Name</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <div class="form-group">
                                <label for="SearchValue" class="form-label">Search Value</label>
                                <input type="text" class="form-control" id="SearchValue" placeholder="Enter value">
                            </div>
                        </div>

                        <div class="col-lg-4 col-md-8">
                            <div class="form-group">
                                <label for="daterange" class="form-label">Date Range</label>
                                <input type="text" id="daterange" class="form-control" placeholder="Select Date Range">
                            </div>
                        </div>

                        <div class="col-lg-2 col-md-4">
                            <div class="form-group">
                                <label class="form-label d-block">&nbsp;</label>
                                <button type="button" class="btn btn-primary w-100" onclick="paging(1)">Search</button>
                            </div>
                        </div>
                    </div>

                    <div class="row" style="margin-top:20px;">
                        <div id="msgDiv">
                            @if (ViewBag.msg != null && (ViewBag.msg).Message_Id == 1)
                            {
                                <div id="myAlert" class="alert alert-success">
                                    <a href="javascript:void(0)" class="close" data-dismiss="alert" aria-label="close" onclick="DivHide()">&times;</a>
                                    <strong>@ViewBag.msg.Message</strong>
                                </div>
                            }
                            else
                            {
                                if (ViewBag.msg != null)
                                {
                                    <div id="myAlert" class="alert alert-danger">
                                        <a href="javascript:void(0)" class="close" data-dismiss="alert" aria-label="close" onclick="DivHide()">&times;</a>
                                        <strong> @ViewBag.msg.Message</strong>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div id="GridDiv">
                                @*@{Html.RenderAction("GetStudentData"); }*@
                            </div>
                            </div>
                        </div>
                    </div>
            </div>
        </section>
    </div>
    @*<footer>
            <div class="footer clearfix mb-0 text-muted">
                <div class="float-start">
                    <p>2022 &copy; SchoolMt</p>
                </div>
            </div>
        </footer>*@
</div>

@*@*******START Loader******@
<div class="modalBgLoader" style="display: none"></div>
<div class="modalLoaderCenter" style="display: none">
    <img alt="Loading..." src="~/App_Images/loader.gif" />
    <span>Loading...</span>
</div>
@*@*******END Loader******@
@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <link href="~/assets/css/daterangepicker.css" rel="stylesheet" />
    <script src="~/assets/js/moment.min.js"></script>
    <script src="~/assets/js/daterangepicker.min.js"></script>
    <script type="text/javascript">

    $(document).ready(function (e) {

        //debugger
        $('#daterange').daterangepicker({
            opens: 'right',
            locale: {
                //format: 'YYYY-MM-DD'
                format: 'DD-MM-YYYY'
            },
            startDate: moment(),
            endDate: moment(),

            // ✅ Allow user to pick any range, across years or months
            showDropdowns: true,            // Allows year/month dropdown
            alwaysShowCalendars: true,     // Keeps calendars visible when ranges exist
            linkedCalendars: false,        // Prevents the 2 calendars from syncing month

            ranges: {
                'Today': [moment(), moment()],
                'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                'Last 30 Days': [moment().subtract(29, 'days'), moment()],
                'This Month': [moment().startOf('month'), moment().endOf('month')],
                'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')]
            }
        });

        paging(1);
        $(function () {
            paging(1);
            $('#SearchCreteria').change(function () {
                $('#SearchValue').val('');
                if ($('#SearchCreteria').val() == '') {
                    paging(1);
                }

            })
        });
    });
        function paging(currentpage) {
        debugger
        if (currentpage == NaN || currentpage <= 0) {
            return false;
        }
        var dateRange = $('#daterange').val();
        var fromDate = "";
        var toDate = "";
        if (dateRange && dateRange.includes('-')) {
            var dates = dateRange.split(' - ');
            fromDate = dates[0].trim();
            toDate = dates[1].trim();
        }
        $.ajax({

            url:"@Url.Action("GetBookOrNoteBookBillData", "BookOrNoteBookBill")",
            type: 'GET',
            cache: false,
            data: { 'CurrentPage': parseInt(currentpage), 'SearchBy': $("#SearchCreteria").val(), 'SearchValue': $("#SearchValue").val(), 'FromDate': fromDate, 'ToDate': toDate  },
            beforeSend: function () {
                $(".modalBgLoader, .modalLoaderCenter").show();
            },
            complete: function () {
                $(".modalBgLoader, .modalLoaderCenter").hide();
            },
            success: function (data) {
                debugger
                $('#GridDiv').html(data);
                if ($('tbody > tr > td > div').html() == 'No Record Found. '){ $('#Export').hide(); }else{ $('#Export').show(); } //Disable "Export to Excel/PDF" Button if there No Record in table.
                $('.disabled').prop('disabled', true);
            },
        });
        return false;
    }
    </script>
}