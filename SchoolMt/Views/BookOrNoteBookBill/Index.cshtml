            // Function to set Book IDs (for selected books)
            function SetBookID() {
                let selectedBooks = [];
                $(".book-checkbox:checked").each(function () {
                    let row = $(this).closest("tr");
                    let bookId = $(this).data("id");
                    let BookName = row.find(".book-Name").text().trim();
                    let price = $(this).data("price");

                    selectedBooks.push({
                        id: bookId,
                        BookName: BookName,
                        price: parseFloat(price)
                    });
                });

                $("#SelectedBookIds").val(JSON.stringify(selectedBooks));
            }

            // Function to set Notebook IDs (for selected notebooks)
            function SetNoteBookID() {
                let selectedNotebooks = [];
                $(".notebook-checkbox:checked").each(function () {
                    let row = $(this).closest("tr");
                    let notebookId = $(this).data("id");
                    let notebookPage = row.find(".notebook-page").text().trim();
                    let price = $(this).data("price");
                    let quantity = row.find(".quantity-input").val() || 1;

                    selectedNotebooks.push({
                        id: notebookId,
                        NotebookPage: notebookPage,
                        price: parseFloat(price),
                        quantity: parseInt(quantity)
                    });
                });

                $("#SelectedNotebookIds").val(JSON.stringify(selectedNotebooks));
            }

            // Function to calculate the subtotal and grand total
            function calculateTotal() {
                let subtotal = 0;

                // Add prices of selected books
                $(".book-checkbox:checked").each(function () {
                    subtotal += parseFloat($(this).data("price")) || 0;
                });

                // Add prices of selected notebooks (including quantity)
                $(".notebook-checkbox:checked").each(function () {
                    subtotal += parseFloat($(this).data("price")) * parseInt($(this).closest("tr").find(".quantity-input").val()) || 0;
                });

                // Set subtotal
                $("#subtotal").val(subtotal.toFixed(2));

                // Calculate GST and grand total
                let gst = parseFloat($("#gst").val()) || 0;
                let discount = parseFloat($("#Discount").val()) || 0;
                let grandTotal = subtotal + gst - discount;

                $("#grandTotal").val(grandTotal.toFixed(2));
            }

            // Fetch the list of books from the server
            function fetchBooks() {
                $.ajax({
                    url: '@Url.Action("GetBooksOrNoteBooks", "BookOrNoteBookBill")',
                    type: "GET",
                    dataType: "json",
                    data: { Type: 'Book', ClassName: $('#ClassName').val() },
                    success: function (data) {
                        let bookTable = $("#bookList tbody");
                        bookTable.empty();

                        if (data.length > 0) {
                            $.each(data, function (index, book) {
                                let row = `<tr>
                                    <td><input type="checkbox" class="form-check-input book-checkbox" data-price="${book.Price}" data-id="${book.PK_BookId}"></td>
                                    <td class="book-Name">${book.BookName}</td>
                                    <td>${book.Price}</td>
                                </tr>`;
                                bookTable.append(row);
                            });

                            // Re-bind event listeners for checkboxes after table is populated
                            bindCheckboxEvents();
                        } else {
                            bookTable.append("<tr><td colspan='3' class='text-center'>No Books Available</td></tr>");
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Error fetching book list: ", error);
                    }
                });
            }

            // Function to bind "Select All" event handlers
            function bindCheckboxEvents() {
                // "Select All" for books
                $('#selectAllBooks').off().on('change', function () {
                    let isChecked = $(this).is(':checked');
                    $('.book-checkbox').prop('checked', isChecked);
                    calculateTotal();  // Recalculate total
                    SetBookID();  // Update selected book IDs
                });

                // "Select All" for notebooks
                $('#selectAllNotebooks').off().on('change', function () {
                    let isChecked = $(this).is(':checked');
                    $('.notebook-checkbox').prop('checked', isChecked);
                    calculateTotal();  // Recalculate total
                    SetNoteBookID();  // Update selected notebook IDs
                });

                // Individual book checkbox change
                $('#bookList').on('change', '.book-checkbox', function () {
                    let allChecked = $('.book-checkbox').length === $('.book-checkbox:checked').length;
                    $('#selectAllBooks').prop('checked', allChecked);
                });

                // Individual notebook checkbox change
                $('#notebookList').on('change', '.notebook-checkbox', function () {
                    let allChecked = $('.notebook-checkbox').length === $('.notebook-checkbox:checked').length;
                    $('#selectAllNotebooks').prop('checked', allChecked);
                });
            }

            // Fetch the list of notebooks from the server
            function fetchNotebooks() {
                $.ajax({
                    url: '@Url.Action("GetBooksOrNoteBooks", "BookOrNoteBookBill")',
                    type: "GET",
                    dataType: "json",
                    data: { Type: 'NoteBook', ClassName: $('#ClassName').val() },
                    success: function (data) {
                        let notebookTable = $("#notebookList tbody");
                        notebookTable.empty();

                        if (data.length > 0) {
                            $.each(data, function (index, notebook) {
                                let row = `<tr>
                                    <td><input type="checkbox" class="form-check-input notebook-checkbox" data-price="${notebook.Price}" data-id="${notebook.PK_BookId}"></td>
                                    <td class="notebook-page">${notebook.NotebookPage}</td>
                                    <td>${notebook.Price}</td>
                                    <td><input type="number" class="form-control quantity-input" value="1" min="1"></td>
                                </tr>`;
                                notebookTable.append(row);
                            });
                        } else {
                            notebookTable.append("<tr><td colspan='3' class='text-center'>No Notebooks Available</td></tr>");
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Error fetching notebook list: ", error);
                    }
                });
            }
        </script>*@

