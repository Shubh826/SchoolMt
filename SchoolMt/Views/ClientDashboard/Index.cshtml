  function DashboardData() {


    // Get and split date range from the input
    var dateRange = $('#daterange').val();
    var fromDate = "";
    var toDate = "";

    if (dateRange && dateRange.includes('-')) {
        var dates = dateRange.split(' - ');
        fromDate = dates[0].trim();
        toDate = dates[1].trim();
    }

    $.ajax({
        url: "@Url.Action("GetDashBoardData", "ClientDashboard")",
        type: 'GET',
        cache: false,
        data: {
            fromDate: fromDate,
            toDate: toDate
        },
        beforeSend: function () {
            $(".modalBgLoader, .modalLoaderCenter").show();
        },
        complete: function () {
            $(".modalBgLoader, .modalLoaderCenter").hide();
        },
        success: function (data) {
           // alert(data.ChartJsonData)
            debugger;
            var lbl = data;
            chartData = JSON.parse(data.ChartJsonData);
            console.log(chartData);
            $('#TotalFee').text(lbl.TotalFee);
            $('#TotalCollectedFee').text(lbl.TotalCollectedFee);
            $('#TotalPendingFee').text(lbl.TotalPendingFee);
            $('#TotalExpense').text(lbl.TotalExpense);
            $('#TotalBookCollection').text(lbl.TotalBookCollection);
            $('#TotalNoteBookCollection').text(lbl.TotalNoteBookCollection);
            $('#TotalStudent').text(lbl.TotalStudent);

            renderMonthlyApexChart(chartData);
            // handle response
        },
        error: function (xhr) {
        }
    });
}

        function renderMonthlyApexChart(data) {
            const months = data.map(d => d.Month);
            const totalFees = data.map(d => parseFloat(d.TotalFee));
            const pendingFees = data.map(d => parseFloat(d.PendingFee));
            const totalExpenses = data.map(d => parseFloat(d.TotalExpense));

            const options = {
                chart: {
                    type: 'bar',
                    height: 400
                },
                series: [
                    { name: 'Total Fee', data: totalFees },
                    { name: 'Pending Fee', data: pendingFees },
                    { name: 'Total Expense', data: totalExpenses }
                ],
                xaxis: {
                    categories: months
                },
                title: {
                    text: 'Monthly Fee & Expense Overview',
                    align: 'center'
                },
                colors: ['#007bff', '#ffc107', '#dc3545'],
                plotOptions: {
                    bar: {
                        horizontal: false,
                        columnWidth: '55%',
                    }
                },
                dataLabels: {
                    enabled: false
                }
            };

            const chart = new ApexCharts(document.querySelector("#monthlyFeeChart"), options);
            chart.render();
        }
    </script>

