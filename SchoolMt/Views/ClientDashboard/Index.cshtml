                                    <h4 class="font-extrabold mb-0"><span id="TotalBookCollection">0</span></h4>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Notebook Collection -->
                    <div class="col-sm-6 col-md-4 col-lg-4 mb-3">
                        <div class="card h-100">
                            <div class="card-body d-flex align-items-center">
                                <div class="me-3">
