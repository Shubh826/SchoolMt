                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Book Collection -->
                    <div class="col-sm-6 col-md-4 col-lg-4 mb-3">
                        <div class="card h-100">
                            <div class="card-body d-flex align-items-center">
                                <div class="me-3">
                                    <div class="stats-icon red"><i class="iconly-boldTick-Square"></i></div>
                                </div>
