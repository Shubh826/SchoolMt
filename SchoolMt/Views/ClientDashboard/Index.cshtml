                    </div>

                    <!-- Total Student -->
                    <div class="col-sm-6 col-md-4 col-lg-4 mb-3">
                        <div class="card h-100">
                            <div class="card-body d-flex align-items-center">
                                <div class="me-3">
                                    <div class="stats-icon blue"><i class="iconly-boldProfile"></i></div>
                                </div>
                                <div>
                                    <h6 class="text-muted font-semibold mb-1">Total Student</h6>
                                    <h4 class="font-extrabold mb-0"><span id="TotalStudent">0</span></h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Chart Section -->
                <div class="row">
                    <div class="col-12">
                        <div class="card">
